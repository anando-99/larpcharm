  gfx->drawFastHLine(x, y + h - 1, w - k, c);
  gfx->drawFastVLine(x + w - 1, y, h - k, c);
  gfx->drawLine(x + w - 1 - k, y + h - 1, x + w - 1, y + h - 1 - k, c);
}

