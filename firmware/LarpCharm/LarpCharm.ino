  CMD_SETTINGS    = 0x0B, // [sleep s u16][swap swipe][flags][tilt]
  CMD_PING        = 0x0C,
  CMD_BUZZ        = 0x0D, // [count]
  CMD_PET_FEED    = 0x0E,
  // 0x0F..0x11 were the video clip commands (removed in 6.0)
  CMD_LOOK        = 0x12, // [background][clock face]([theme])
  CMD_TIMER       = 0x13, // [seconds u16]  (0 = cancel)
