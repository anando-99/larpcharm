  CMD_BRIGHTNESS  = 0x08, // [0..255]
  CMD_PET         = 0x09, // [species][r][g][b] name
  CMD_CARD        = 0x0A, // [r][g][b] name 0x1F subtitle
  CMD_SETTINGS    = 0x0B, // [sleep s u16][swap swipe][flags][tilt]
  CMD_PING        = 0x0C,
