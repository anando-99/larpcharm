// ═════════════ v8.6: weather, in the Japanese countryside ═════════════
// The web app looks the weather up (Open-Meteo) for a place you pick and sends it over Bluetooth.
// A pixel-art kid stands on a country path by the rice paddies, dressed for the temperature and the sky,
// in a scene that follows the season (summer, sakura spring, momiji autumn, snowy winter) and the weather:
// clouds drift, rain splashes, snow and petals and leaves fall, dragonflies dart, fireflies glow, lightning strikes.
enum WxCond : uint8_t { WX_CLEAR, WX_PARTLY, WX_CLOUDY, WX_FOG, WX_DRIZZLE, WX_RAIN, WX_SNOW, WX_THUNDER };
const char *WX_NAME[8] = {"clear", "partly cloudy", "cloudy", "fog", "drizzle", "rain", "snow", "thunderstorm"};
struct Wx {
  bool have = false, isDay = true, fahr = false;
  uint8_t cond = WX_CLEAR, hum = 0, wind = 0, rain = 0, hn = 0;
  int8_t t = 0, feels = 0, hi = 0, lo = 0;
  uint8_t hHour[4] = {0}, hCond[4] = {0};
  int8_t hT[4] = {0};
  char place[24] = "";
  uint32_t at = 0;
} wx;
const uint16_t WX_OL = c565(34, 24, 40);
uint32_t wxSayUntil = 0, wxHopAt = 0, wxSpinUntil = 0;
const char *wxSay = "";

// ── data from the web app: [cond][day][t][feels][hi][lo][hum][wind][rain%][fahr][n] n*[hour][cond][t] place ──
void wxPacket(const uint8_t *p, uint16_t len) {
  if (len < 11) return;
  wx.cond = p[0] % 8; wx.isDay = p[1]; wx.t = (int8_t)p[2]; wx.feels = (int8_t)p[3]; wx.hi = (int8_t)p[4]; wx.lo = (int8_t)p[5];
  wx.hum = p[6]; wx.wind = p[7]; wx.rain = p[8]; wx.fahr = p[9]; wx.hn = min(4, (int)p[10]);
  int o = 11;
  for (int i = 0; i < wx.hn && o + 2 < len; i++, o += 3) { wx.hHour[i] = p[o]; wx.hCond[i] = p[o + 1] % 8; wx.hT[i] = (int8_t)p[o + 2]; }
  String place = o < len ? asciiOnly(String((const char *)(p + o), len - o)) : String("");
  snprintf(wx.place, sizeof(wx.place), "%s", place.c_str());
  wx.have = true; wx.at = millis();
  prefs.putBytes("wx", &wx, sizeof(wx));
  klog("wx: %d%c %s, %s", wx.t, wx.fahr ? 'F' : 'C', WX_NAME[wx.cond], wx.place);
}
void wxLoad() { Wx w; if (prefs.getBytes("wx", &w, sizeof(w)) == sizeof(w) && w.have) { wx = w; wx.at = 0; } }
int wxCelsius(int t) { return wx.fahr ? (t - 32) * 5 / 9 : t; }

void wxDeg(int x, int y, int r, uint16_t c) { gfx->drawCircle(x, y, r, c); if (r > 1) gfx->drawCircle(x, y, r - 1, c); }

// small weather icons, for the forecast strip
void wxIcon(uint8_t cond, int cx, int cy, int s, bool day) {
  const uint16_t SUN = c565(255, 206, 60), CLOUD = c565(236, 240, 248), DARK = c565(150, 156, 176), DROP = c565(90, 170, 255), MOON = c565(240, 236, 200);
  bool cloud = cond != WX_CLEAR;
  if (cond <= WX_PARTLY) {
    if (day) { gfx->fillCircle(cx - (cloud ? s / 3 : 0), cy - (cloud ? s / 3 : 0), s / 2, SUN); }
    else { gfx->fillCircle(cx - s / 4, cy - s / 4, s / 2, MOON); gfx->fillCircle(cx, cy - s / 2, s / 2, c565(10, 14, 30)); }
  }
  if (cloud) {
    uint16_t cc = cond >= WX_RAIN || cond == WX_CLOUDY ? DARK : CLOUD;
    gfx->fillCircle(cx - s / 3, cy + s / 8, s / 3, cc); gfx->fillCircle(cx + s / 4, cy, s / 2.5, cc); gfx->fillRoundRect(cx - s / 1.6, cy + s / 8, s * 1.2, s / 3, s / 6, cc);
  }
  if (cond == WX_DRIZZLE || cond == WX_RAIN || cond == WX_THUNDER) for (int i = -1; i <= 1; i++) gfx->drawLine(cx + i * s / 3, cy + s / 2, cx + i * s / 3 - 2, cy + s / 2 + s / 3, DROP);
  if (cond == WX_SNOW) for (int i = -1; i <= 1; i++) gfx->fillRect(cx + i * s / 3 - 1, cy + s / 2 + 1, 2, 2, COL_WHITE);
  if (cond == WX_THUNDER) gfx->fillTriangle(cx, cy + s / 3, cx - s / 5, cy + s * 0.75f, cx + s / 6, cy + s * 0.6f, SUN);
  if (cond == WX_FOG) for (int i = 0; i < 3; i++) gfx->drawFastHLine(cx - s / 2 + (i % 2) * 2, cy - s / 4 + i * s / 4, s - 2, CLOUD);
}

// ── the art (wx_art.h, made by firmware/tools/mkwxart.py from pixel art drawn with SpriteCook) ──
// One spot in the Japanese countryside in five looks, recoloured on the fly for rain, grey skies, fog,
// night and lightning; a sky painted underneath; the kid in eight outfits; particles drawn in code.
enum { WXB_SUMMER, WXB_SPRING, WXB_AUTUMN, WXB_WINTER, WXB_NIGHT };
enum { WXG_NIGHT = 1, WXG_OVERCAST = 2, WXG_RAIN = 4, WXG_FOG = 8, WXG_FLASH = 16, WXG_DUSK = 32 };
const int WX_KX = 124, WX_GY = 252;                                     // where the kid stands
struct WxLook { int bg, band; uint8_t grade; bool day, wet, snow, flash; };
WxLook wxL;                                                             // the look for this frame (wxLookUp)

static inline uint32_t wxH(uint32_t i, uint32_t k) { uint32_t x = (i * 2654435761u) ^ (k * 40503u); x ^= x >> 15; x *= 2246822519u; x ^= x >> 13; return x; }
static inline void wxPx(int x, int y, uint16_t c) { if (x >= 0 && x < SCR_W && y >= 0 && y < SCR_H) { if (FB) FB[y * SCR_W + x] = c; else gfx->drawPixel(x, y, c); } }
static inline void wxMix(int x, int y, uint16_t c, uint8_t a) { if (FB && x >= 0 && x < SCR_W && y >= 0 && y < SCR_H) FB[y * SCR_W + x] = blend565(FB[y * SCR_W + x], c, a); }
void wxGlow(int cx, int cy, int r, uint16_t c, uint8_t a) {            // a soft round light
  for (int y = -r; y <= r; y++) for (int x = -r; x <= r; x++) { int d = x * x + y * y; if (d <= r * r) wxMix(cx + x, cy + y, c, (uint8_t)(a * (r * r - d) / (r * r))); }
}

// colour grades: the same picture goes grey, rainy, foggy, dark or lit by lightning
void wxGrade(uint8_t &r, uint8_t &g, uint8_t &b, uint8_t gr) {
  float R = r, G = g, B = b, L;
  if (gr & WXG_OVERCAST) { L = 0.3f * R + 0.59f * G + 0.11f * B; R = (R + (L - R) * 0.35f) * 0.86f; G = (G + (L - G) * 0.35f) * 0.88f; B = (B + (L - B) * 0.3f) * 0.93f; }
  if (gr & WXG_RAIN)     { L = 0.3f * R + 0.59f * G + 0.11f * B; R = (R + (L - R) * 0.45f) * 0.66f; G = (G + (L - G) * 0.45f) * 0.7f; B = (B + (L - B) * 0.4f) * 0.78f + 10; }
  if (gr & WXG_FOG)      { L = 0.3f * R + 0.59f * G + 0.11f * B; R = R + (L - R) * 0.3f; G = G + (L - G) * 0.3f; B = B + (L - B) * 0.3f; R += (206 - R) * 0.42f; G += (210 - G) * 0.42f; B += (216 - B) * 0.42f; }
  if (gr & WXG_NIGHT)    { R = R * 0.3f; G = G * 0.36f; B = B * 0.55f + 16; }
  if (gr & WXG_DUSK)     { R = R * 0.72f; G = G * 0.76f; B = B * 0.88f + 10; }
  if (gr & WXG_FLASH)    { R += (255 - R) * 0.55f; G += (255 - G) * 0.55f; B += (255 - B) * 0.6f; }
  r = (uint8_t)constrain((int)(R + 0.5f), 0, 255); g = (uint8_t)constrain((int)(G + 0.5f), 0, 255); b = (uint8_t)constrain((int)(B + 0.5f), 0, 255);
}
void wxPal(const uint8_t *src, int n, uint8_t gr, uint16_t *dst) {
  for (int i = 0; i < n; i++) { uint8_t r = pgm_read_byte(src + i * 3), g = pgm_read_byte(src + i * 3 + 1), b = pgm_read_byte(src + i * 3 + 2); wxGrade(r, g, b, gr); dst[i] = c565(r, g, b); }
}
const int WXK_PN = sizeof(WXK_PAL) / 3, WXS_PN = sizeof(WXS_PAL) / 3;
uint16_t wxBgPal[256], wxKidPal[WXK_PN], wxSkyPal[WXS_PN], wxSkyRaw[WXS_PN];
int wxBgKey = -1, wxKidKey = -1, wxSkyKey = -1;

// what to show: the season follows the temperature, the grade follows the sky and the clock
void wxLookUp(uint32_t now) {
  WxLook &L = wxL;
  int c = wxCelsius(wx.t);
  L.band = !wx.have ? 2 : c >= 28 ? 4 : c >= 20 ? 3 : c >= 12 ? 2 : c >= 4 ? 1 : 0;
  L.day = !wx.have || wx.isDay;
  L.wet = wx.have && (wx.cond == WX_RAIN || wx.cond == WX_DRIZZLE || wx.cond == WX_THUNDER);
  L.snow = wx.have && wx.cond == WX_SNOW;
  L.flash = wx.have && wx.cond == WX_THUNDER && (now % 3100 < 140 || (now % 3100 > 220 && now % 3100 < 290));
  L.bg = L.snow || L.band == 0 ? WXB_WINTER : L.band == 1 ? WXB_AUTUMN : L.band == 2 ? WXB_SPRING : WXB_SUMMER;
  L.grade = 0;
  if (!L.day) { if (L.bg == WXB_SUMMER && !L.wet && wx.cond <= WX_CLOUDY) L.bg = WXB_NIGHT; else L.grade |= WXG_NIGHT; }
  if (L.wet) L.grade |= WXG_RAIN;
  else if (wx.have && (wx.cond == WX_CLOUDY || L.snow)) L.grade |= WXG_OVERCAST;
  else if (wx.have && wx.cond == WX_FOG) L.grade |= WXG_FOG;
  if (L.flash) L.grade |= WXG_FLASH;
}

// a picture from the art, index 0 transparent
void wxBlit(const uint8_t *px, int w, int h, int x0, int y0, const uint16_t *pal, bool flip) {
  for (int y = 0; y < h; y++) {
    int sy = y0 + y; if (sy < 0 || sy >= SCR_H) continue;
    const uint8_t *row = px + y * w;
    for (int x = 0; x < w; x++) { uint8_t i = pgm_read_byte(row + (flip ? w - 1 - x : x)); if (i) wxPx(x0 + x, sy, pal[i]); }
  }
}
void wxSkyPiece(int k, int x, int y, bool graded) { wxBlit(WXS_PX + WXS_OFF[k], WXS_W[k], WXS_H[k], x, y, graded ? wxSkyPal : wxSkyRaw, false); }

// ── the sky, painted in chunky bands, with its sun or moon, stars, drifting clouds and lightning ──
void wxSky(uint32_t now) {
  const WxLook &L = wxL;
  uint8_t c = wx.have ? wx.cond : WX_PARTLY;
  uint8_t t[3], b[3];
  auto set = [&](uint8_t r0, uint8_t g0, uint8_t b0, uint8_t r1, uint8_t g1, uint8_t b1) { t[0] = r0; t[1] = g0; t[2] = b0; b[0] = r1; b[1] = g1; b[2] = b1; };
  if (L.flash) set(214, 214, 255, 255, 255, 255);
  else if (!L.day) { if (L.wet) set(8, 10, 20, 30, 34, 52); else if (c <= WX_PARTLY) set(4, 8, 26, 30, 42, 92); else set(14, 16, 30, 44, 48, 70); }
  else if (c == WX_THUNDER) set(42, 36, 68, 98, 94, 124);
  else if (L.wet) set(72, 88, 114, 140, 152, 172);
  else if (L.snow) set(148, 164, 194, 218, 226, 240);
  else if (c == WX_FOG) set(150, 156, 168, 206, 210, 216);
  else if (c == WX_CLOUDY) set(108, 132, 168, 188, 200, 218);
  else if (L.band >= 4) set(52, 128, 230, 255, 214, 150);
  else set(52, 128, 230, 160, 214, 255);
  int sky = WXB_Y0[L.bg] + 40;                                           // the art's top rows are mostly sky too
  for (int y = 0; y < sky; y += 4) {
    float k = (float)y / sky;
    gfx->fillRect(0, y, SCR_W, 4, c565(t[0] + (b[0] - t[0]) * k, t[1] + (b[1] - t[1]) * k, t[2] + (b[2] - t[2]) * k));
  }
  gfx->fillRect(0, sky, SCR_W, SCR_H - sky, c565(b[0], b[1], b[2]));     // the art has gaps in places; nothing stale shows through
  if (!L.day && c <= WX_PARTLY) {                                        // stars that twinkle, and now and then a shooting one
    for (int i = 0; i < 30; i++) {
      int x = wxH(i, 1) % SCR_W, y = wxH(i, 2) % (sky - 8), tw = (now / 300 + wxH(i, 3)) % 9;
      uint16_t col = tw == 0 ? c565(90, 100, 140) : i % 5 == 0 ? c565(255, 240, 200) : COL_WHITE;
      wxPx(x, y, col);
      if (i % 7 == 0 && tw > 5) { wxPx(x - 1, y, c565(120, 130, 180)); wxPx(x + 1, y, c565(120, 130, 180)); wxPx(x, y - 1, c565(120, 130, 180)); wxPx(x, y + 1, c565(120, 130, 180)); }
    }
    uint32_t sp = now % 9000;
    if (sp < 600) { int x = 70 + sp / 5, y = 14 + sp / 16; for (int k = 0; k < 14; k++) wxMix(x - k * 2, y - k, COL_WHITE, 255 - k * 18); }
  }
  if (L.day && c <= WX_PARTLY) wxSkyPiece(4, 186, 18 + (int)(sinf(now / 2200.0f) * 1.5f), false);
  if (!L.day && c <= WX_CLOUDY) wxSkyPiece(5, 192, 18, false);
  // clouds: which, at what height, how fast (px per second, more with wind)
  static const int8_t SETS[8][4] = { {2, -1, -1, -1}, {0, 2, 1, -1}, {0, 1, 0, 2}, {1, 0, 2, 1}, {3, 1, -1, -1}, {3, 0, 3, -1}, {1, 0, -1, -1}, {3, 3, 3, 0} };
  static const uint8_t CY[4] = {28, 54, 12, 70};
  float wind = 3 + (wx.have ? wx.wind : 8) / 4.0f;
  for (int i = 0; i < 4; i++) {
    int k = SETS[c][i]; if (k < 0) continue;
    if (!L.day && c == WX_CLEAR) continue;
    int w = WXS_W[k], span = SCR_W + w + 60;
    int x = (int)((now / 1000.0f) * wind * (0.6f + i * 0.25f) + wxH(i, c) % span) % span - w - 30;
    wxSkyPiece(k, x, CY[i], true);
  }
  if (L.flash) {                                                         // a crooked bolt down to the hills
    int x = 150 + (now / 3100) % 3 * 22, y = 40;
    uint32_t s = now / 3100;
    while (y < sky + 20) {
      int nx = x + (int)(wxH(s, y) % 13) - 6, ny = y + 8;
      for (int k = 0; k <= 8; k++) { int px = x + (nx - x) * k / 8, py = y + k; wxPx(px, py, c565(255, 250, 200)); wxPx(px + 1, py, COL_WHITE); wxMix(px - 1, py, c565(255, 240, 140), 120); wxMix(px + 2, py, c565(255, 240, 140), 120); }
      x = nx; y = ny;
    }
  }
}

// ── critters and bits that live in the scene ──
void wxDragonfly(int x, int y, uint16_t body, uint32_t now) {
  for (int k = 0; k < 6; k++) wxPx(x + k, y, body);
  wxPx(x + 6, y, mix565(body, COL_BLACK, 90));
  bool up = (now / 40) % 2;
  uint16_t wing = c565(220, 236, 255);
  wxMix(x + 3, y - 1 - up, wing, 200); wxMix(x + 4, y - 1 - up, wing, 200); wxMix(x + 3, y + 1 + up, wing, 200); wxMix(x + 4, y + 1 + up, wing, 200);
}
void wxBack(uint32_t now) {
  const WxLook &L = wxL;
  uint8_t c = wx.have ? wx.cond : WX_PARTLY;
  bool fair = !L.wet && !L.snow && c != WX_FOG;
  // birds over the hills on fair days, crows under grey skies
  if (L.day && !L.wet && c != WX_FOG && L.bg != WXB_WINTER) {
    for (int i = 0; i < 3; i++) {
      int x = (int)((now / 38 + i * 97) % 320) - 40, y = 84 + i * 9 + (int)(sinf(now / 600.0f + i) * 3), f = (now / 170 + i) % 2;
      uint16_t col = c == WX_CLOUDY ? c565(30, 30, 36) : c565(40, 40, 60);
      wxPx(x - 2, y - f, col); wxPx(x - 1, y - (f ? 0 : 1) + 0, col); wxPx(x, y, col); wxPx(x + 1, y - (f ? 0 : 1), col); wxPx(x + 2, y - f, col);
    }
  }
  // dragonflies darting about: blue in summer, red in autumn
  if (L.day && fair && (L.bg == WXB_SUMMER || L.bg == WXB_AUTUMN)) {
    for (int i = 0; i < 2; i++) {
      uint32_t seg = now / 1300 + i * 7, t = now % 1300;
      float e = t < 500 ? 1 - (1 - t / 500.0f) * (1 - t / 500.0f) : 1;
      int x0 = 20 + wxH(seg, i) % 190, y0 = 150 + wxH(seg, i + 9) % 80, x1 = 20 + wxH(seg + 1, i) % 190, y1 = 150 + wxH(seg + 1, i + 9) % 80;
      wxDragonfly(x0 + (int)((x1 - x0) * e), y0 + (int)((y1 - y0) * e) + (int)(sinf(now / 90.0f + i) * 1), L.bg == WXB_AUTUMN ? c565(220, 50, 36) : c565(60, 150, 230), now);
    }
  }
  // butterflies over the spring and summer flowers
  if (L.day && fair && (L.bg == WXB_SUMMER || L.bg == WXB_SPRING)) {
    for (int i = 0; i < 2; i++) {
      int x = 40 + i * 120 + (int)(sinf(now / 1700.0f + i * 2) * 40 + sinf(now / 430.0f + i) * 6), y = 214 + (int)(sinf(now / 900.0f + i * 3) * 14);
      uint16_t col = i ? c565(255, 236, 120) : COL_WHITE;
      bool open = (now / 110 + i) % 2;
      wxPx(x, y, c565(60, 50, 40));
      if (open) { wxPx(x - 1, y - 1, col); wxPx(x - 2, y - 1, col); wxPx(x - 1, y, col); wxPx(x + 1, y - 1, col); wxPx(x + 2, y - 1, col); wxPx(x + 1, y, col); }
      else { wxPx(x - 1, y - 1, col); wxPx(x + 1, y - 1, col); }
    }
  }
  // summer: specks of pollen drifting up in the light
  if (L.day && fair && L.bg == WXB_SUMMER)
    for (int i = 0; i < 10; i++) { int x = (wxH(i, 4) % SCR_W + (int)(sinf(now / 1200.0f + i) * 8)), y = 250 - (int)((now / 40 + (wxH(i, 5) & 1023)) % 160); wxMix(x, y, c565(255, 250, 210), 150); }
  // winter: the snow glitters
  if (L.bg == WXB_WINTER && L.day && !L.wet)
    for (int i = 0; i < 10; i++) { uint32_t s = now / 160 + i * 13; if (wxH(s, i) % 3) continue; int x = wxH(s, 7) % SCR_W, y = 190 + wxH(s, 8) % 60; wxPx(x, y, COL_WHITE); wxMix(x - 1, y, COL_WHITE, 140); wxMix(x + 1, y, COL_WHITE, 140); wxMix(x, y - 1, COL_WHITE, 140); wxMix(x, y + 1, COL_WHITE, 140); }
  // fireflies on warm nights
  if (!L.day && !L.wet && !L.snow && L.band >= 2)
    for (int i = 0; i < 12; i++) {
      int x = 10 + wxH(i, 6) % 220 + (int)(sinf(now / 1500.0f + i * 1.7f) * 14), y = 150 + wxH(i, 7) % 90 + (int)(sinf(now / 1100.0f + i) * 10);
      float p = 0.5f + 0.5f * sinf(now / 380.0f + i * 2.1f);
      if (p < 0.15f) continue;
      wxGlow(x, y, 4, c565(200, 255, 110), (uint8_t)(p * 150)); wxPx(x, y, c565(240, 255, 170));
    }
}

// rain, snow, petals, leaves, fog and wind: drawn over the kid
void wxFront(uint32_t now) {
  const WxLook &L = wxL;
  uint8_t c = wx.have ? wx.cond : WX_PARTLY;
  int wind = wx.have ? wx.wind : 8;
  if (L.wet) {
    int n = c == WX_DRIZZLE ? 26 : c == WX_THUNDER ? 70 : 54, len = c == WX_DRIZZLE ? 4 : 7, slant = min(wind / 8, 4);
    uint16_t col = L.flash ? COL_WHITE : L.day ? c565(190, 214, 255) : c565(120, 140, 190);
    for (int i = 0; i < n; i++) {
      int v = 7 + wxH(i, 11) % 5, ground = 200 + wxH(i, 12) % 52;
      int y = (int)((now / 33 * v + (wxH(i, 13) & 1023)) % (ground + 30)) - 30, x = (wxH(i, 14) % (SCR_W + 40)) - 20 + y * slant / 12;
      if (y < ground - len) { for (int k = 0; k < len; k++) wxMix(x - k * slant / 6, y - k, col, 210 - k * 18); }
      else { int d = y - (ground - len); if (d < 6) { wxMix(x - d, ground - d / 2, col, 200); wxMix(x + d, ground - d / 2, col, 200); wxMix(x, ground, col, 140); } }
    }
  }
  if (L.snow) {
    for (int i = 0; i < 70; i++) {
      int sz = wxH(i, 21) % 2 == 0 ? 2 : 1, v = 2 + wxH(i, 22) % 3 + sz;
      int y = (int)((now / 25 * v / 4 + (wxH(i, 23) & 1023)) % 300) - 10, x = (int)(wxH(i, 24) % 260) - 10 + (int)(sinf(now / 700.0f + i) * 4) + y * wind / 300;
      gfx->fillRect(x, y, sz, sz, COL_WHITE); if (sz == 2) wxMix(x - 1, y, COL_WHITE, 90);
    }
  }
  if (!L.wet && !L.snow && L.bg == WXB_SPRING) {                       // sakura petals, fluttering down
    static const uint16_t PET[3] = { c565(255, 183, 197), c565(255, 216, 226), c565(236, 140, 168) };
    for (int i = 0; i < 18; i++) {
      int v = 3 + wxH(i, 31) % 3;
      int y = (int)((now / 40 * v / 3 + (wxH(i, 32) & 1023)) % 310) - 20, x = (int)(((wxH(i, 33) & 1023) + now / 60 * (1 + wind / 6)) % 280) - 20 + (int)(sinf(now / 500.0f + i) * 5);
      uint16_t col = PET[i % 3]; int ph = (now / 160 + i) % 3;
      wxPx(x, y, col); if (ph == 0) wxPx(x + 1, y, col); else if (ph == 1) wxPx(x, y + 1, col); else { wxPx(x + 1, y, col); wxPx(x, y + 1, col); }
    }
  }
  if (!L.wet && !L.snow && L.bg == WXB_AUTUMN) {                       // maple leaves, tumbling
    static const uint16_t LEAF[3] = { c565(222, 62, 40), c565(242, 122, 42), c565(250, 176, 54) };
    for (int i = 0; i < 10; i++) {
      int v = 2 + wxH(i, 41) % 3;
      int y = (int)((now / 37 * v / 3 + (wxH(i, 42) & 1023)) % 310) - 20, x = (int)(((wxH(i, 43) & 1023) + now / 70 * (1 + wind / 5)) % 280) - 20 + (int)(sinf(now / 650.0f + i) * 9);
      uint16_t col = LEAF[i % 3];
      if ((now / 220 + i) % 2) { wxPx(x, y - 1, col); wxPx(x - 1, y, col); wxPx(x, y, col); wxPx(x + 1, y, col); wxPx(x, y + 1, mix565(col, COL_BLACK, 70)); }
      else { wxPx(x - 1, y - 1, col); wxPx(x + 1, y - 1, col); wxPx(x, y, col); wxPx(x - 1, y + 1, col); wxPx(x + 1, y + 1, mix565(col, COL_BLACK, 70)); }
    }
  }
  if (wx.have && c == WX_FOG && FB)                                      // fog, drifting in bands
    for (int b = 0; b < 4; b++) {
      int y0 = 96 + b * 44 + (int)(sinf(now / 1500.0f + b) * 6);
      for (int y = y0; y < y0 + 18 && y < SCR_H; y++) {
        uint8_t a = (uint8_t)(90 * sinf((y - y0) / 18.0f * 3.1416f));
        int off = (int)(now / (40 + b * 10)) % 60;
        for (int x = 0; x < SCR_W; x++) { uint8_t aa = (uint8_t)(a * (0.75f + 0.25f * sinf((x + off) / 9.5f))); FB[y * SCR_W + x] = blend565(FB[y * SCR_W + x], c565(230, 232, 236), aa); }
      }
    }
  if (wind >= 20 && !L.snow)                                             // gusts
    for (int i = 0; i < 4; i++) {
      int len = 14 + wxH(i, 51) % 12, y = 110 + wxH(i, 52) % 130, x = (int)((now / 40 * (8 + i) + (wxH(i, 53) & 1023)) % 360) - 60;
      for (int k = 0; k < len; k++) wxMix(x + k, y + (k > len - 4 ? -(k - len + 4) / 2 : 0), COL_WHITE, 120 - k * 4);
    }
}

// ── the kid: one sprite per outfit, 0 hot, 1 warm, 2 mild, 3 cool, 4 freezing, 5 rain, 6 snow, 7 night ──
// It breathes, sways with the tilt, hops when tapped, turns to look around, shivers in the cold and trembles
// at thunder, with drawn extras: a lantern glow at night, frosty breath, a bead of sweat, hearts, a "!".
int wxOutfit() {
  const WxLook &L = wxL;
  if (L.wet) return 5;
  if (L.snow) return 6;
  if (!L.day && L.band >= 2) return 7;
  return 4 - constrain(L.band, 0, 4);
}
// draws frame f with its feet centred on (cx, gy): squash shortens it by a few rows, lean shears the top sideways
void wxKid(int f, int cx, int gy, int squash, float lean, bool flip) {
  const uint8_t *px = WXK_PX[f];
  int h = WXK_H - squash, x0 = cx - WXK_W / 2;
  for (int dy = 0; dy < h; dy++) {
    int sy = dy * WXK_H / h, y = gy - h + dy;
    if (y < 0 || y >= SCR_H) continue;
    int sh = (int)roundf(lean * (h - dy) / h);
    const uint8_t *row = px + sy * WXK_W;
    for (int sx = 0; sx < WXK_W; sx++) { uint8_t i = pgm_read_byte(row + (flip ? WXK_W - 1 - sx : sx)); if (i) wxPx(x0 + sx + sh, y, wxKidPal[i]); }
  }
}
uint32_t wxTurnAt = 0, wxHeartAt = 0;
void wxPup(uint32_t now) {
  const WxLook &L = wxL;
  int f = wxOutfit();
  bool scared = wx.have && wx.cond == WX_THUNDER, cold = f == 4 || f == 6;
  int key = L.day ? 0 : WXG_DUSK;
  if (key != wxKidKey) { wxPal(WXK_PAL, WXK_PN, key, wxKidPal); wxKidKey = key; }
  int cx = WX_KX, gy = WX_GY;
  uint32_t ht = now - wxHopAt;
  int hop = ht < 420 ? (int)(sinf(ht / 420.0f * 3.1416f) * 18) : 0;
  int squash = ht >= 420 && ht < 560 ? 4 - (int)((ht - 420) / 35) : 0;
  if (!hop && !squash) squash = sinf(now / 560.0f) > 0.6f ? 1 : 0;   // breathing
  float lean = imuOK ? constrain(tiltX * 4.0f, -4.0f, 4.0f) : sinf(now / 1400.0f) * 1.5f;
  if (scared) lean = sinf(now / 45.0f) * 1.5f;
  int shiver = (cold || scared) && (now / 70) % 2 ? 1 : 0;
  if (now > wxTurnAt + 5200 && !random(0, 160)) wxTurnAt = now;      // now and then it looks the other way
  bool flip = (now - wxTurnAt < 1600) || (now < wxSpinUntil && (now / 110) % 2);
  if (now < wxSpinUntil) hop = max(hop, (int)(fabsf(sinf(now / 110.0f)) * 6));
  if (FB) {                                                           // a soft shadow that shrinks as it hops
    int rx = 17 - hop / 3;
    for (int y = -2; y <= 2; y++) { int dx = (int)(rx * sqrtf(1.0f - y * y / 6.0f)); for (int x = cx - dx; x <= cx + dx; x++) wxMix(x, gy + y, c565(20, 16, 30), 110); }
  }
  int top = gy - hop - WXK_H + squash;
  int lx = flip ? WXK_W - 1 - WXK_LX : WXK_LX;
  if (f == 7) wxGlow(cx - WXK_W / 2 + lx, top + WXK_LY, 16, c565(255, 180, 90), 110 + (int)(sinf(now / 140.0f) * 20));
  wxKid(f, cx + shiver, gy - hop, squash, lean, flip);
  if (f == 7) wxGlow(cx - WXK_W / 2 + lx, top + WXK_LY, 4, c565(255, 230, 160), 120);
  if (cold) for (int i = 0; i < 3; i++) { float pz = fmodf(now / 1400.0f + i * 0.33f, 1.0f); int px = cx + (flip ? -8 : 8) + (int)((flip ? -1 : 1) * pz * 16), py = top + 28 - (int)(pz * 10); wxGlow(px, py, 1 + (int)(pz * 4), COL_WHITE, (uint8_t)(200 * (1 - pz))); }
  if (f == 0 && L.day) { int k = (now / 900) % 2 ? 1 : -1, sy = (now / 90) % 10; wxPx(cx + k * 17, top + 14 + sy, c565(150, 210, 255)); wxPx(cx + k * 17, top + 15 + sy, c565(110, 180, 255)); }
  if (scared && (now / 400) % 2) textAt("!", cx + 22, top - 4, 2, c565(255, 220, 80));
  if (now - wxHeartAt < 1500) {
    float pz = (now - wxHeartAt) / 1500.0f;
    for (int k = -1; k <= 1; k += 2) {
      int hx = cx + k * (18 + (int)(pz * 8)), hy = top + 8 - (int)(pz * 24);
      uint16_t hc = c565(255, 110, 150);
      gfx->fillCircle(hx - 2, hy, 2, hc); gfx->fillCircle(hx + 2, hy, 2, hc); gfx->fillTriangle(hx - 4, hy + 1, hx + 4, hy + 1, hx, hy + 5, hc);
    }
  }
}

void wxScene(uint32_t now) {
  wxLookUp(now);
  int key = wxL.bg * 64 + wxL.grade;
  if (key != wxBgKey) { wxPal(WXB_PAL[wxL.bg], 256, wxL.grade, wxBgPal); wxBgKey = key; }
  uint8_t sg = wxL.grade | (wxL.day || wxL.bg != WXB_NIGHT ? 0 : WXG_NIGHT);   // clouds darken at night too
  if (sg != wxSkyKey) { wxPal(WXS_PAL, WXS_PN, sg, wxSkyPal); wxSkyKey = sg; }
  static bool rawDone = false;
  if (!rawDone) { wxPal(WXS_PAL, WXS_PN, 0, wxSkyRaw); rawDone = true; }
  wxSky(now);
  int y0 = WXB_Y0[wxL.bg];
  wxBlit(WXB_PX + WXB_OFF[wxL.bg], SCR_W, SCR_H - y0, 0, y0, wxBgPal, false);
  wxBack(now);
}

void drawWeather() {
  uint32_t now = millis();
  wxScene(now);
