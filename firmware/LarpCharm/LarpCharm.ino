// ═════════════ v5: step counter ═════════════
void stepFeed(float x, float y, float z, uint32_t now) {
  float m = sqrtf(x * x + y * y + z * z);
  stepLP = stepLP * 0.7f + m * 0.3f;
  if (!stepArmed && stepLP < 1.03f) stepArmed = true;
  if (stepArmed && stepLP > 1.17f && now - lastStepAt > 260) {
    stepArmed = false;
    if (now - lastStepAt > 2000) stepRun = 0;
    lastStepAt = now;
    if (stepRun < 255) stepRun++;
    if (stepRun == 5) stepsToday += 5;                  // ignore single bumps: count once a rhythm starts
    else if (stepRun > 5) stepsToday++;
  }
}
void stepDayCheck() {
  struct tm t;
  if (!localNow(t)) return;
  if (stepDay != t.tm_yday) {
    if (stepDay >= 0) stepsToday = 0;
    stepDay = t.tm_yday;
    prefs.putShort("sday", stepDay);
    prefs.putULong("steps", stepsToday);
  }
  if (stepsToday - stepsSaved >= 200) { stepsSaved = stepsToday; prefs.putULong("steps", stepsToday); petMood = min(100, petMood + 1); }
}


// ═════════════ v6.1: Sing-along, a pencil-doodle kitten acts out your words ═════════════
// The website sends a short "show": lines of text, and for each line a face, a prop, a scene and
// optionally its own colour, plus a tempo, a theme and the text colour. Words pop in one per beat in
// pencil lettering and wander all over the screen. A small doodle kitten pops in and out, hops from
// word to word, peeks round the edges, hides behind the words, or leaves the words on their own.
// Everything is drawn into an 8-bit "pencil layer" and laid onto paper through a fixed graphite grain,
// so strokes look like pencil and coloured pencil. Strokes re-wobble about nine times a second.
// sing.js on the website is a line-by-line port of this file, so its preview matches the charm.
#define SHOW_MAX_LINES 24
#define SHOW_MAX_LEN   64
#define SHOW_MAX_WORDS 32
enum SingFace : uint8_t { SF_HAPPY, SF_LOVE, SF_SAD, SF_SHY, SF_GRUMPY, SF_SURPRISED, SF_EXCITED, SF_DREAMY, SF_SINGING, SF_CHEEKY, SF_COUNT };
enum SingProp : uint8_t { SP_NONE, SP_GIFT, SP_HEART, SP_STAR, SP_CANE, SP_MIC, SP_COUNT };
enum SingTheme : uint8_t { ST_XMAS, ST_LOVE, ST_PARTY, ST_PLAIN, ST_COUNT };
// scenes: how the words and the kitten share the screen (0 = pick one for me)
enum SingScene : uint8_t { SS_AUTO, SS_RING, SS_WORDS, SS_PEEK, SS_STROLL, SS_BIG, SS_HIDE, SS_HOP, SS_BUBBLE, SS_COUNT };
struct ShowLine { uint8_t face, prop, scene, own; uint16_t col; char text[SHOW_MAX_LEN + 1]; };
ShowLine showLine[SHOW_MAX_LINES];
const uint16_t S_GRAPH = c565(54, 52, 62);
uint8_t  showN = 0, showBpm = 96, showTheme = ST_XMAS, showFlags = 3;    // flags: 1 = voice blips, 2 = hat
uint16_t showInk = S_GRAPH;
bool     showLoaded = false, singPaused = false;
uint32_t singT0 = 0, singPausedAt = 0;
int      singLastWord = -1;
uint32_t singJumpAt = 0;
bool     sLayOK = false;

void showDefault() {                                   // an original little verse to start with
  static const struct { uint8_t f, p, s; const char *t; } D[] = {
    {SF_GRUMPY, SP_GIFT, SS_AUTO, "No big bows and no shiny wrapping"},
    {SF_DREAMY, SP_NONE, SS_AUTO, "keep the tinsel, keep the sleigh"},
    {SF_LOVE, SP_HEART, SS_AUTO, "I just want my favourite person"},
    {SF_SHY, SP_HEART, SS_AUTO, "sitting next to me all day"},
    {SF_EXCITED, SP_STAR, SS_AUTO, "Merry Christmas!"},
  };
  showN = sizeof(D) / sizeof(D[0]);
  for (int i = 0; i < showN; i++) {
    ShowLine &L = showLine[i];
    L.face = D[i].f; L.prop = D[i].p; L.scene = D[i].s; L.own = 0; L.col = S_GRAPH;
    strncpy(L.text, D[i].t, SHOW_MAX_LEN); L.text[SHOW_MAX_LEN] = 0;
  }
  showBpm = 96; showTheme = ST_XMAS; showFlags = 3; showInk = S_GRAPH;
  sLayOK = false;
}

// ver 1: "LSHW" 1 bpm theme flags n, then n x [face prop len text]
// ver 2: "LSHW" 2 bpm theme flags n inkHi inkLo, then n x [face prop scene colHi colLo len text]
//        scene: low 4 bits the scene, bit 7 set = the line has its own colour (RGB565)
bool showParse(const uint8_t *b, uint32_t n) {
  if (n < 9 || memcmp(b, "LSHW", 4) || (b[4] != 1 && b[4] != 2)) return false;
  uint8_t ver = b[4], bpm = b[5], th = b[6], fl = b[7], cnt = b[8];
  if (bpm < 40 || bpm > 200 || th >= ST_COUNT || cnt == 0 || cnt > SHOW_MAX_LINES) return false;
  uint32_t o = 9;
  uint16_t ink = S_GRAPH;
  if (ver == 2) { if (n < 11) return false; ink = (uint16_t)((b[9] << 8) | b[10]); o = 11; }
  static ShowLine tmp[SHOW_MAX_LINES];
  for (int i = 0; i < cnt; i++) {
    uint32_t hd = ver == 2 ? 6 : 3;
    if (o + hd > n) return false;
    uint8_t f = b[o], p = b[o + 1], sc = 0, own = 0, len; uint16_t col = ink;
    if (ver == 2) { sc = b[o + 2] & 15; own = b[o + 2] >> 7; col = (uint16_t)((b[o + 3] << 8) | b[o + 4]); len = b[o + 5]; }
    else len = b[o + 2];
    o += hd;
    if (f >= SF_COUNT || p >= SP_COUNT || sc >= SS_COUNT || len > SHOW_MAX_LEN || o + len > n) return false;
    tmp[i].face = f; tmp[i].prop = p; tmp[i].scene = sc; tmp[i].own = own; tmp[i].col = col;
    for (int k = 0; k < len; k++) { char c = (char)b[o + k]; tmp[i].text[k] = (c >= 32 && c <= 126) ? c : ' '; }
    tmp[i].text[len] = 0; o += len;
  }
  memcpy(showLine, tmp, sizeof(ShowLine) * cnt);
  showN = cnt; showBpm = bpm; showTheme = th; showFlags = fl; showInk = ink;
  sLayOK = false;
  return true;
}

void singLoad() {
  showLoaded = true;
  if (fsOK && FFat.exists("/show.bin")) {
    File f = FFat.open("/show.bin", "r");
    if (f) {
      static uint8_t buf[2048];
      uint32_t n = f.read(buf, sizeof(buf)); f.close();
      if (showParse(buf, n)) return;
    }
  }
  showDefault();
}
void singRestart() { singT0 = millis(); singPaused = false; singLastWord = -1; }

// ───── randomness that the website can repeat exactly ─────
static int sBoil = 0;
static inline uint32_t sHash(uint32_t x) { x ^= x >> 16; x *= 0x7feb352dU; x ^= x >> 15; x *= 0x846ca68bU; x ^= x >> 16; return x; }
static inline float sJit(int a, int b) { return (int)(sHash((uint32_t)(a * 7919 + b * 104729 + sBoil * 31337)) & 1023) / 511.5f - 1.0f; }
static inline float sHf(int a, int b) { return (sHash((uint32_t)(a * 7919 + b * 104729)) & 65535) / 65536.0f; }   // steady 0..1
uint32_t sRs = 1;
float sRf() { sRs ^= sRs << 13; sRs ^= sRs >> 17; sRs ^= sRs << 5; return (sRs >> 8) / 16777216.0f; }
float sRr(float a, float b) { return a + (b - a) * sRf(); }
uint32_t sFnv(const char *s) { uint32_t h = 2166136261U; for (; *s; s++) { h ^= (uint8_t)*s; h *= 16777619U; } return h; }
float sClamp(float v, float a, float b) { return v < a ? a : v > b ? b : v; }
float sEase(float p) { p = sClamp(p, 0, 1); return p * p * (3 - 2 * p); }

// ───── the pencil layer ─────
uint8_t  *sLayer = nullptr, *sGrain = nullptr, *sWord = nullptr;
uint16_t *sPaper = nullptr;
int sPaperTheme = -1;
uint16_t sPaperCol = 0xFFFF;
int sDx0 = SCR_W, sDy0 = SCR_H, sDx1 = -1, sDy1 = -1;    // dirty box of the layer
float sClipY = 9999;                                     // nothing is drawn at or below this line
bool  sMeasure = false;                                  // reveal: first measure the ink, then draw only part of it
float sMeasured = 0, sBudget = -1;
#define SW_W 360
#define SW_H 100

bool singBuffers() {
  if (sLayer) return true;
  sLayer = (uint8_t *)ps_malloc(SCR_W * SCR_H);
  sPaper = (uint16_t *)ps_malloc(SCR_W * SCR_H * 2);
  sWord  = (uint8_t *)ps_malloc(SW_W * SW_H);
  sGrain = (uint8_t *)ps_malloc(64 * 64);
  if (!sLayer || !sPaper || !sWord || !sGrain) return false;
  memset(sLayer, 0, SCR_W * SCR_H);
  // graphite grain: the paper's tooth catches the pencil unevenly, with a faint diagonal drag
  for (int y = 0; y < 64; y++) for (int x = 0; x < 64; x++) {
    uint32_t h = sHash((uint32_t)(x * 73 + y * 9187 + 11)), h2 = sHash((uint32_t)(((x + y) & 63) * 131 + (y >> 2) * 7 + 5));
    int v = 168 + (int)(h & 63) + (int)(h2 & 31) - (((h >> 8) & 15) == 0 ? 60 : 0);
    sGrain[y * 64 + x] = (uint8_t)sClamp(v, 90, 255);
  }
  return true;
}

void pSeg(float x0, float y0, float x1, float y1, float w, uint8_t a) {
  float dx = x1 - x0, dy = y1 - y0, L = sqrtf(dx * dx + dy * dy);
  if (sMeasure) { sMeasured += L + 0.5f; return; }
  if (sBudget >= 0) {
    if (sBudget <= 0) return;
    float need = L + 0.5f;
    if (need > sBudget) { float f = sBudget / need; x1 = x0 + dx * f; y1 = y0 + dy * f; dx = x1 - x0; dy = y1 - y0; }
    sBudget -= need; if (sBudget < 0) sBudget = 0;
  }
  if (w < 1.0f) w = 1.0f;
  float R = w * 0.5f + 0.5f;
  int bx0 = (int)floorf(fminf(x0, x1) - R), bx1 = (int)ceilf(fmaxf(x0, x1) + R);
  int by0 = (int)floorf(fminf(y0, y1) - R), by1 = (int)ceilf(fmaxf(y0, y1) + R);
  if (bx0 < 0) bx0 = 0; if (by0 < 0) by0 = 0; if (bx1 > SCR_W - 1) bx1 = SCR_W - 1; if (by1 > SCR_H - 1) by1 = SCR_H - 1;
  if (by1 >= sClipY) by1 = (int)ceilf(sClipY) - 1;
  if (bx0 > bx1 || by0 > by1) return;
  float L2 = dx * dx + dy * dy, inv = L2 > 1e-4f ? 1.0f / L2 : 0, R2 = R * R;
  for (int y = by0; y <= by1; y++) {
    uint8_t *row = sLayer + y * SCR_W;
    float py = y - y0;
    for (int x = bx0; x <= bx1; x++) {
      float px = x - x0, t = (px * dx + py * dy) * inv;
      if (t < 0) t = 0; else if (t > 1) t = 1;
      float ex = px - t * dx, ey = py - t * dy, d2 = ex * ex + ey * ey;
      if (d2 >= R2) continue;
      float c = R - sqrtf(d2); if (c > 1) c = 1;
      uint8_t v = (uint8_t)(c * a);
      if (v > row[x]) row[x] = v;
    }
  }
  if (bx0 < sDx0) sDx0 = bx0; if (bx1 > sDx1) sDx1 = bx1; if (by0 < sDy0) sDy0 = by0; if (by1 > sDy1) sDy1 = by1;
}
// lay the layer onto the frame in one colour, through the grain, and clear it
void pFlush(uint16_t col, uint8_t alpha) {
  if (sDx1 < 0) return;
  for (int y = sDy0; y <= sDy1; y++) {
    uint8_t *row = sLayer + y * SCR_W;
    const uint8_t *g = sGrain + ((y & 63) << 6);
    uint16_t *fb = FB + y * SCR_W;
    for (int x = sDx0; x <= sDx1; x++) {
      uint32_t a = row[x];
      if (!a) continue;
      row[x] = 0;
      a = (a * g[x & 63]) >> 8; a = (a * alpha) >> 8;
      if (a) fb[x] = mix565(fb[x], col, (uint8_t)a);
    }
  }
  sDx0 = SCR_W; sDy0 = SCR_H; sDx1 = -1; sDy1 = -1;
}
// solid fill (paper colour) so a doodle hides what is behind it; skipped while measuring or revealing
void pFill(const float *xs, const float *ys, int n, uint16_t col) {
  if (sMeasure || sBudget >= 0) return;
  float mn = 1e9f, mx = -1e9f;
  for (int i = 0; i < n; i++) { mn = fminf(mn, ys[i]); mx = fmaxf(mx, ys[i]); }
  int y0 = (int)ceilf(mn), y1 = (int)floorf(mx);
  if (y0 < 0) y0 = 0; if (y1 > SCR_H - 1) y1 = SCR_H - 1; if (y1 >= sClipY) y1 = (int)ceilf(sClipY) - 1;
  for (int y = y0; y <= y1; y++) {
    float xv[16]; int m = 0;
    for (int i = 0; i < n && m < 16; i++) {
      int j = (i + 1) % n;
      float ya = ys[i], yb = ys[j];
      if ((ya <= y && yb > y) || (yb <= y && ya > y)) xv[m++] = xs[i] + (y - ya) * (xs[j] - xs[i]) / (yb - ya);
    }
    for (int a = 1; a < m; a++) { float v = xv[a]; int b = a - 1; while (b >= 0 && xv[b] > v) { xv[b + 1] = xv[b]; b--; } xv[b + 1] = v; }
    for (int k = 0; k + 1 < m; k += 2) {
      int xa = (int)ceilf(xv[k]), xb = (int)floorf(xv[k + 1]);
      if (xa < 0) xa = 0; if (xb > SCR_W - 1) xb = SCR_W - 1;
      uint16_t *fb = FB + y * SCR_W;
      for (int x = xa; x <= xb; x++) fb[x] = col;
    }
  }
}
// coloured-pencil hatching across a polygon (screen coordinates), diagonal strokes
void pHatch(const float *xs, const float *ys, int n, float gap, float w, uint8_t a, int seed) {
  const float c = 0.7071f, s = -0.7071f;                 // hatch direction: up and to the right
  float vmn = 1e9f, vmx = -1e9f;
  for (int i = 0; i < n; i++) { float v = -xs[i] * s + ys[i] * c; vmn = fminf(vmn, v); vmx = fmaxf(vmx, v); }
  int k = 0;
  for (float v = vmn + gap * 0.5f; v < vmx; v += gap, k++) {
    float uv[16]; int m = 0;
    for (int i = 0; i < n && m < 16; i++) {
      int j = (i + 1) % n;
      float va = -xs[i] * s + ys[i] * c, vb = -xs[j] * s + ys[j] * c;
      if ((va <= v && vb > v) || (vb <= v && va > v)) {
        float f = (v - va) / (vb - va), x = xs[i] + (xs[j] - xs[i]) * f, y = ys[i] + (ys[j] - ys[i]) * f;
        uv[m++] = x * c + y * s;
      }
    }
    for (int q = 1; q < m; q++) { float t = uv[q]; int b = q - 1; while (b >= 0 && uv[b] > t) { uv[b + 1] = uv[b]; b--; } uv[b + 1] = t; }
    for (int q = 0; q + 1 < m; q += 2) {
      float u0 = uv[q] + 0.6f + sJit(seed, k) * 0.7f, u1 = uv[q + 1] - 0.6f + sJit(seed + 1, k) * 0.7f;
      if (u1 <= u0) continue;
      pSeg(u0 * c - v * s, u0 * s + v * c, u1 * c - v * s, u1 * s + v * c, w, a);
    }
  }
}

// ───── the kitten's frame: local units, feet at (0,0), y up is negative ─────
float kTx = 120, kTy = 200, kC = 1, kS = 0, kSc = 1;     // kitten frame
bool  kFlip = false;
float kOx = 0, kOy = 0, kHc = 1, kHs = 0;                // sub-frame (the head) inside the kitten frame
void kSub(float ox, float oy, float ang) { kOx = ox; kOy = oy; kHc = cosf(ang); kHs = sinf(ang); }
void kP(float x, float y, float &X, float &Y) {
  float lx = kOx + x * kHc - y * kHs, ly = kOy + x * kHs + y * kHc;
  if (kFlip) lx = -lx;
  X = kTx + (lx * kC - ly * kS) * kSc; Y = kTy + (lx * kS + ly * kC) * kSc;
}
void kLine(float x0, float y0, float x1, float y1, float w, uint8_t a) {
  float X0, Y0, X1, Y1; kP(x0, y0, X0, Y0); kP(x1, y1, X1, Y1); pSeg(X0, Y0, X1, Y1, w * kSc, a);
}
void kDot(float x, float y, float r, uint8_t a) { float X, Y; kP(x, y, X, Y); pSeg(X, Y, X, Y, 2 * r * kSc, a); }
// a wobbly ellipse arc; seed keeps its wobble its own
void kArc(float cx, float cy, float rx, float ry, float a0, float sweep, float w, uint8_t a, int seed) {
  int n = (int)(fabsf(sweep) * fmaxf(rx, ry) * kSc / 3.2f); if (n < 4) n = 4; if (n > 40) n = 40;
  float px = 0, py = 0;
  for (int i = 0; i <= n; i++) {
    float t = a0 + sweep * i / n, j = 1 + 0.045f * sJit(seed, i % 40);
    float x = cx + cosf(t) * rx * j, y = cy + sinf(t) * ry * j;
    if (i) kLine(px, py, x, y, w, a);
    px = x; py = y;
  }
}
// a closed doodle outline that overshoots where it starts, like a quick pencil loop
void kLoop(float cx, float cy, float rx, float ry, float w, int seed) {
  float a0 = sHf(seed, 1) * 6.2832f;
  kArc(cx, cy, rx, ry, a0, 6.2832f + 0.42f, w, 235, seed);
}
void kPoly(const float *lx, const float *ly, int n, float *X, float *Y) { for (int i = 0; i < n; i++) kP(lx[i], ly[i], X[i], Y[i]); }
void kFillEll(float cx, float cy, float rx, float ry) {
  float X[16], Y[16];
  for (int i = 0; i < 16; i++) { float t = i * 0.3927f; kP(cx + cosf(t) * rx, cy + sinf(t) * ry, X[i], Y[i]); }
  pFill(X, Y, 16, sPaperCol);
}
void kHatchEll(float cx, float cy, float rx, float ry, float gap, uint8_t a, int seed) {
  float X[12], Y[12];
  for (int i = 0; i < 12; i++) { float t = i * 0.5236f; kP(cx + cosf(t) * rx, cy + sinf(t) * ry, X[i], Y[i]); }
  pHatch(X, Y, 12, gap, 1.15f, a, seed);
}
void kBez(float x0, float y0, float x1, float y1, float x2, float y2, float x3, float y3, float w0, float w1, int n) {
  float px = x0, py = y0;
  for (int i = 1; i <= n; i++) {
    float t = (float)i / n, u = 1 - t;
    float x = u * u * u * x0 + 3 * u * u * t * x1 + 3 * u * t * t * x2 + t * t * t * x3;
    float y = u * u * u * y0 + 3 * u * u * t * y1 + 3 * u * t * t * y2 + t * t * t * y3;
    kLine(px, py, x, y, w0 + (w1 - w0) * t, 235);
    px = x; py = y;
  }
}
// small shapes in the current frame
void kHeartPts(float x, float y, float r, float *lx, float *ly) {
  for (int i = 0; i < 12; i++) {
    float t = i * 0.5236f;
    float hx = 16 * powf(sinf(t), 3), hy = -(13 * cosf(t) - 5 * cosf(2 * t) - 2 * cosf(3 * t) - cosf(4 * t));
    lx[i] = x + hx * r / 16; ly[i] = y + hy * r / 16;
  }
}
void kHeart(float x, float y, float r, uint16_t col, uint8_t alpha, int seed) {
  float lx[12], ly[12], X[12], Y[12];
  kHeartPts(x, y, r, lx, ly); kPoly(lx, ly, 12, X, Y);
  pHatch(X, Y, 12, 2.0f, 1.2f, 230, seed); pFlush(col, alpha);
  for (int i = 0; i < 12; i++) kLine(lx[i], ly[i], lx[(i + 1) % 12], ly[(i + 1) % 12], 1.4f, 235);
  pFlush(col, alpha);
}
void kStar(float x, float y, float r, float spin, uint16_t col, uint8_t alpha, int seed) {
  float lx[10], ly[10], X[10], Y[10];
  for (int i = 0; i < 10; i++) { float a = spin - 1.5708f + i * 0.6283f, rr = (i & 1) ? r * 0.45f : r; lx[i] = x + cosf(a) * rr; ly[i] = y + sinf(a) * rr; }
  kPoly(lx, ly, 10, X, Y);
  pHatch(X, Y, 10, 1.8f, 1.2f, 230, seed); pFlush(col, alpha);
  for (int i = 0; i < 10; i++) kLine(lx[i], ly[i], lx[(i + 1) % 10], ly[(i + 1) % 10], 1.3f, 235);
  pFlush(mix565(col, S_GRAPH, 110), alpha);
}
void kSpark(float x, float y, float r, uint16_t col, uint8_t alpha) {
  kLine(x - r, y, x + r, y, 1.3f, 235); kLine(x, y - r, x, y + r, 1.3f, 235);
  kLine(x - r * 0.45f, y - r * 0.45f, x + r * 0.45f, y + r * 0.45f, 1.0f, 200); kLine(x - r * 0.45f, y + r * 0.45f, x + r * 0.45f, y - r * 0.45f, 1.0f, 200);
  pFlush(col, alpha);
}

const uint16_t K_PINK = c565(240, 116, 158), K_RED = c565(222, 62, 72), K_BLUE = c565(92, 148, 228), K_YEL = c565(238, 182, 36), K_GRN = c565(64, 158, 92);

// ───── props, hats and little extras ─────
void caneP(float x, float y, int i, float &qx, float &qy) {        // a candy cane: a stick, then a hook
  if (i <= 5) { qx = x + 3; qy = y + 13 - i * 4.4f; }
  else { float a = 3.1416f * (i - 5) / 5.0f; qx = x - 1.4f + cosf(a) * 4.4f; qy = y - 9 - sinf(a) * 4.4f; }
}
void kProp(uint8_t p, float x, float y, float t) {
  switch (p) {
    case SP_GIFT: {
      float r = sinf(t * 2) * 0.08f, lx[4], ly[4], X[4], Y[4];
      for (int i = 0; i < 4; i++) { float a = r + 0.7854f + i * 1.5708f; lx[i] = x + cosf(a) * 9.5f; ly[i] = y + sinf(a) * 9.5f; }
      kPoly(lx, ly, 4, X, Y); pFill(X, Y, 4, sPaperCol);
      pHatch(X, Y, 4, 2.0f, 1.2f, 230, 501); pFlush(K_RED, 255);
      for (int i = 0; i < 4; i++) kLine(lx[i], ly[i], lx[(i + 1) % 4], ly[(i + 1) % 4], 1.5f, 235);
      kLine((lx[0] + lx[1]) / 2, (ly[0] + ly[1]) / 2, (lx[2] + lx[3]) / 2, (ly[2] + ly[3]) / 2, 2.2f, 235);
      kLine((lx[1] + lx[2]) / 2, (ly[1] + ly[2]) / 2, (lx[3] + lx[0]) / 2, (ly[3] + ly[0]) / 2, 2.2f, 235);
      float bx = (lx[2] + lx[3]) / 2, by = (ly[2] + ly[3]) / 2;
      kArc(bx - 3.5f, by - 3, 3.5f, 2.6f, 0, 6.2832f, 1.3f, 235, 502); kArc(bx + 3.5f, by - 3, 3.5f, 2.6f, 0, 6.2832f, 1.3f, 235, 503);
      pFlush(S_GRAPH, 255);
      break;
    }
    case SP_HEART: kHeart(x, y, 9 + sinf(t * 8) * 1.0f, K_PINK, 255, 504); break;
    case SP_STAR:  kStar(x, y, 10, sinf(t * 3) * 0.3f, K_YEL, 255, 505); break;
    case SP_CANE: {
      float px = x + 3, py = y + 13, qx, qy;
      for (int i = 1; i <= 10; i++) { caneP(x, y, i, qx, qy); if (i % 2) kLine(px, py, qx, qy, 3.4f, 240); px = qx; py = qy; }
      pFlush(K_RED, 255);
      px = x + 3; py = y + 13;
      for (int i = 1; i <= 10; i++) {
        caneP(x, y, i, qx, qy);
        float nx = -(qy - py), ny = qx - px, nl = sqrtf(nx * nx + ny * ny) + 1e-3f; nx = nx / nl * 2.2f; ny = ny / nl * 2.2f;
        kLine(px + nx, py + ny, qx + nx, qy + ny, 1.0f, 220); kLine(px - nx, py - ny, qx - nx, qy - ny, 1.0f, 220);
        px = qx; py = qy;
      }
      pFlush(S_GRAPH, 255);
      break;
    }
    case SP_MIC:
      kLine(x, y + 3, x - 2, y + 15, 2.8f, 240);
      kArc(x, y - 2, 4.8f, 4.8f, 0, 6.2832f, 1.5f, 235, 506);
      kLine(x - 3.5f, y - 3, x + 3.5f, y - 3, 1.0f, 170); kLine(x - 3.5f, y - 0.5f, x + 3.5f, y - 0.5f, 1.0f, 170); kLine(x, y - 6, x, y + 2, 1.0f, 170);
      pFlush(S_GRAPH, 255);
      break;
  }
}
// hats sit on the head frame (head centre at 0,0)
void kHat(float t) {
  if (showTheme == ST_PARTY) {
    float lx[3] = {-9, 8, 1 + sinf(t * 2) * 2}, ly[3] = {-11, -13, -33}, X[3], Y[3];
    kPoly(lx, ly, 3, X, Y); pFill(X, Y, 3, sPaperCol);
    pHatch(X, Y, 3, 2.2f, 1.2f, 220, 611); pFlush(K_BLUE, 255);
    for (int k = 1; k < 4; k++) { float f = k / 4.0f; kLine(lx[0] + (lx[2] - lx[0]) * f, ly[0] + (ly[2] - ly[0]) * f, lx[1] + (lx[2] - lx[1]) * f, ly[1] + (ly[2] - ly[1]) * f, 1.6f, 230); }
    pFlush(K_YEL, 255);
    kLine(lx[0], ly[0], lx[2], ly[2], 1.5f, 235); kLine(lx[1], ly[1], lx[2], ly[2], 1.5f, 235); kLine(lx[0], ly[0], lx[1], ly[1], 1.3f, 235);
    pFlush(S_GRAPH, 255);
    kHatchEll(lx[2], ly[2] - 1, 3, 3, 1.5f, 230, 612); pFlush(K_PINK, 255);
    return;
  }
  float flop = sinf(t * 2.2f) * 2;                       // a santa hat that flops to one side
  float lx[5] = {-14, -4, 9, 18 + flop, 12}, ly[5] = {-9, -26, -27, -18 + flop * 0.5f, -12}, X[5], Y[5];
  kPoly(lx, ly, 5, X, Y); pFill(X, Y, 5, sPaperCol);
  pHatch(X, Y, 5, 1.9f, 1.2f, 235, 613); pFlush(K_RED, 255);
  for (int i = 0; i < 4; i++) kLine(lx[i], ly[i], lx[i + 1], ly[i + 1], 1.5f, 235);
  float bx[4] = {-16, 14, 14, -16}, by[4] = {-13.5f, -16, -9.5f, -7}, BX[4], BY[4];
  kPoly(bx, by, 4, BX, BY); pFill(BX, BY, 4, sPaperCol);
  for (int i = 0; i < 4; i++) kLine(bx[i], by[i], bx[(i + 1) % 4], by[(i + 1) % 4], 1.4f, 225);
  kFillEll(lx[3] + 1, ly[3] + 2, 3.8f, 3.8f);
  kArc(lx[3] + 1, ly[3] + 2, 3.8f, 3.8f, 0, 6.6f, 1.4f, 225, 614);
  pFlush(S_GRAPH, 255);
}

// ───── the kitten ─────
// pose 0 sit, 1 walk, 2 jump, 3 peek (only head and paws, gripping an edge at y = -19)
#define K_SIT 0
#define K_WALK 1
#define K_JUMP 2
#define K_PEEK 3
void kitten(uint8_t face, uint8_t prop, uint8_t pose, float t, float beatPh, float talk, float u) {
  const uint16_t G = S_GRAPH;
  kSub(0, 0, 0);
  float sq = powf(1 - sClamp(beatPh, 0, 1), 3);
  bool blink = fmodf(t + 0.37f * u, 3.3f) < 0.14f;
  float tailSw = face == SF_GRUMPY ? sinf(t * 9) * 4 : face == SF_DREAMY ? sinf(t * 1.2f) * 6 : sinf(t * 2.6f) * 5;
  float headX = 0, headY = -36, tilt = 0;
  bool propHeld = prop != SP_NONE && pose != K_WALK && pose != K_PEEK;
  bool pawCheek = face == SF_SHY && pose == K_SIT;
  // ── body ──
  if (pose == K_SIT) {
    float bry = 12 * (1 - 0.07f * sq), brx = 12.5f * (1 + 0.07f * sq);
    kBez(9, -4, 24, -3, 27 + tailSw * 0.3f, -18, 19 + tailSw, -27, 2.8f, 2.0f, 8);
    pFlush(G, 255);
    kFillEll(0, -bry, brx, bry);
    kLoop(0, -bry, brx, bry, 1.7f, 720);
    kFillEll(-5, -2.2f, 4, 2.7f); kArc(-5, -2.2f, 4, 2.7f, 3.3f, 3.4f, 1.5f, 235, 721);
    if (!propHeld) { kFillEll(5, -2.2f, 4, 2.7f); kArc(5, -2.2f, 4, 2.7f, 3.3f, 3.4f, 1.5f, 235, 722); }
    pFlush(G, 255);
    headY = -2 * bry - 11;
    tilt = (face == SF_DREAMY ? sinf(t * 1.6f) * 0.16f : face == SF_SHY ? -0.12f + sinf(t * 2) * 0.04f : sinf(beatPh * 3.1416f) * 0.07f * ((int)u % 2 ? 1 : -1));
  } else if (pose == K_WALK) {
    float step = t * 9;
    kBez(-14, -14, -24, -16, -27 + tailSw * 0.3f, -26, -22 + tailSw * 0.6f, -34, 2.6f, 2.0f, 8);
    pFlush(G, 255);
    for (int k = 0; k < 4; k++) {                      // four little legs
      float lx = -9 + k * 6, sw = sinf(step + (k % 2) * 3.1416f) * 3;
      kLine(lx, -8, lx + sw, -0.8f, 2.0f, 235);
    }
    pFlush(G, 255);
    kFillEll(0, -13, 16, 9.5f);
    kLoop(0, -13, 16, 9.5f, 1.7f, 723);
    pFlush(G, 255);
    headX = 13; headY = -28; tilt = sinf(step) * 0.05f;
  } else if (pose == K_PEEK) {
    tilt = sinf(t * 2) * 0.09f;
  } else if (pose == K_JUMP) {
    kBez(8, -12, 20, -8, 26 + tailSw * 0.4f, -22, 20 + tailSw, -32, 2.6f, 2.0f, 8);
    pFlush(G, 255);
    kFillEll(-5, -2, 3.4f, 3); kArc(-5, -2, 3.4f, 3, 0, 6.6f, 1.4f, 235, 724);
    kFillEll(5, -2, 3.4f, 3); kArc(5, -2, 3.4f, 3, 0, 6.6f, 1.4f, 235, 725);
    kFillEll(0, -15, 11, 14);
    kLoop(0, -15, 11, 14, 1.7f, 726);
    kLine(-8, -22, -15, -34, 2.0f, 235); kDot(-15.5f, -35, 2.2f, 235);    // arms up
    if (!propHeld) { kLine(8, -22, 15, -34, 2.0f, 235); kDot(15.5f, -35, 2.2f, 235); }
    pFlush(G, 255);
    headY = -41;
  }
  // ── head ──
  kSub(headX, headY, tilt);
  float earSp = 0, earL = 1;
  if (face == SF_SAD) { earSp = 0.55f; earL = 0.85f; }
  else if (face == SF_GRUMPY) { earSp = 0.42f; earL = 0.85f; }
  else if (face == SF_SURPRISED) { earSp = -0.08f; earL = 1.15f; }
  else if (face == SF_EXCITED) earSp = sinf(t * 14) * 0.1f;
  float twitch = (fmodf(t, 4.1f) < 0.18f) ? 0.22f : 0;
  float ex[2][3], ey[2][3];                              // ear base, tip, base
  for (int e = 0; e < 2; e++) {
    float s = e ? 1 : -1, b1x = s * 14.5f, b1y = -5.5f, b2x = s * 4.5f, b2y = -12.8f, mx = (b1x + b2x) / 2, my = (b1y + b2y) / 2;
    float tx = s * 14, ty = -24 * earL, a = s * (earSp + (e ? twitch : 0)), ca = cosf(a), sa = sinf(a);
    float rx = tx - mx, ry = ty - my;
    ex[e][0] = b1x; ey[e][0] = b1y; ex[e][1] = mx + rx * ca - ry * sa; ey[e][1] = my + rx * sa + ry * ca; ex[e][2] = b2x; ey[e][2] = b2y;
  }
  kFillEll(0, 0, 17, 14);
  for (int e = 0; e < 2; e++) { float X[3], Y[3]; kPoly(ex[e], ey[e], 3, X, Y); pFill(X, Y, 3, sPaperCol); }
  // pink: inner ears, cheeks, heart eyes
  for (int e = 0; e < 2; e++) {
    float lx[3], ly[3], X[3], Y[3], cx = (ex[e][0] + ex[e][1] + ex[e][2]) / 3, cy = (ey[e][0] + ey[e][1] + ey[e][2]) / 3;
    for (int k = 0; k < 3; k++) { lx[k] = cx + (ex[e][k] - cx) * 0.55f; ly[k] = cy + (ey[e][k] - cy) * 0.55f + 1; }
    kPoly(lx, ly, 3, X, Y); pHatch(X, Y, 3, 1.7f, 1.0f, 200, 730 + e);
  }
  bool bigBlush = face == SF_SHY || face == SF_LOVE;
  if (face != SF_GRUMPY) for (int s = -1; s <= 1; s += 2) kHatchEll(s * 10.5f, 4.8f, bigBlush ? 3.6f : 2.8f, bigBlush ? 2.4f : 1.8f, 1.5f, bigBlush ? 230 : 170, 740 + s);
  if (face == SF_LOVE) for (int s = -1; s <= 1; s += 2) { float lx[12], ly[12], X[12], Y[12]; kHeartPts(s * 6.5f, -0.5f, 3.6f + sinf(t * 10) * 0.4f, lx, ly); kPoly(lx, ly, 12, X, Y); pHatch(X, Y, 12, 1.3f, 1.0f, 240, 745 + s); }
  pFlush(K_PINK, 255);
  // graphite: head, ears, face
  kLoop(0, 0, 17, 14, 1.8f, 750);
  for (int e = 0; e < 2; e++) { kLine(ex[e][0], ey[e][0], ex[e][1], ey[e][1], 1.7f, 235); kLine(ex[e][1], ey[e][1], ex[e][2], ey[e][2], 1.7f, 235); }
  for (int s = -1; s <= 1; s += 2) {                    // whiskers
    kLine(s * 11.5f, 2.5f, s * 20, 0.8f, 1.05f, 200);
    kLine(s * 11.5f, 5, s * 19.5f, 6.8f, 1.05f, 200);
  }
  const float EX = 6.5f;
  switch (face) {
    case SF_LOVE: for (int s = -1; s <= 1; s += 2) { float lx[12], ly[12]; kHeartPts(s * EX, -0.5f, 3.6f + sinf(t * 10) * 0.4f, lx, ly); for (int i = 0; i < 12; i++) kLine(lx[i], ly[i], lx[(i + 1) % 12], ly[(i + 1) % 12], 1.1f, 230); } break;
    case SF_SHY: case SF_SINGING:
      for (int s = -1; s <= 1; s += 2) kArc(s * EX, 1, 2.8f, 2.4f, 3.5f, 2.4f, 1.6f, 235, 760 + s);       // happy closed ^ ^
      if (face == SF_SHY) for (int s = -1; s <= 1; s += 2) for (int k = 0; k < 3; k++) kLine(s * 9 + k * 1.8f - 1, 3.4f, s * 9 + k * 1.8f - 2.2f, 6.2f, 0.9f, 170);
      break;
    case SF_DREAMY: for (int s = -1; s <= 1; s += 2) kArc(s * EX, -0.5f, 2.8f, 2.2f, 0.3f, 2.5f, 1.6f, 235, 762 + s); break;   // sleepy ‿ ‿
    case SF_SURPRISED:
      for (int s = -1; s <= 1; s += 2) { kArc(s * EX, -0.5f, 3.6f, 3.9f, 0, 6.6f, 1.4f, 235, 764 + s); kDot(s * EX + 0.4f, 0, 1.5f, 240); }
      break;
    case SF_EXCITED:
      for (int s = -1; s <= 1; s += 2) { float x = s * EX; kLine(x - s * 2.8f, -3, x + s * 2, -0.3f, 1.6f, 235); kLine(x + s * 2, -0.3f, x - s * 2.8f, 2.4f, 1.6f, 235); }
      break;
    case SF_GRUMPY:
      for (int s = -1; s <= 1; s += 2) { kLine(s * 3, -3.4f, s * 10, -1.2f, 1.5f, 235); if (!blink) kDot(s * EX, 1, 1.5f, 240); }
      break;
    case SF_CHEEKY:
      if (blink) kLine(-EX - 2, 0, -EX + 2, 0, 1.5f, 235); else kDot(-EX, 0, 1.9f, 240);
      kLine(EX - 2.6f, -2.4f, EX + 2.2f, 0, 1.5f, 235); kLine(EX + 2.2f, 0, EX - 2.6f, 2.2f, 1.5f, 235);
      break;
    default:                                             // happy and sad: dot eyes
      for (int s = -1; s <= 1; s += 2) {
        float yy = face == SF_SAD ? 1 : 0;
        if (blink) kLine(s * EX - 2.2f, yy, s * EX + 2.2f, yy, 1.5f, 235); else kDot(s * EX, yy, 1.9f, 240);
        if (face == SF_SAD) kLine(s * 3.4f, -4.6f, s * 9.6f, -3.1f, 1.3f, 225);
      }
      break;
  }
  // mouth: a little "w", opening on each word
  float my = 5;
  switch (face) {
    case SF_SAD:
      if (talk > 0.25f) kArc(0, my + 2.6f, 1.8f, 1.2f + talk * 1.4f, 0, 6.6f, 1.3f, 235, 770);
      else kArc(0, my + 4.2f, 3, 2.2f, 3.5f, 2.4f, 1.4f, 235, 771);
      break;
    case SF_GRUMPY:
      kLine(-3.2f, my + 2.6f, -1, my + 1.6f, 1.3f, 235); kLine(-1, my + 1.6f, 1, my + 2.6f, 1.3f, 235); kLine(1, my + 2.6f, 3.2f, my + 1.6f, 1.3f, 235);
      break;
    case SF_SURPRISED: kArc(0, my + 3, 2 + talk * 0.6f, 2.4f + talk * 1.2f, 0, 6.6f, 1.3f, 235, 772); break;
    case SF_EXCITED: case SF_SINGING: {
      float h = 2.4f + talk * 2.2f + (face == SF_SINGING ? 1 : 0);
      kArc(0, my + 1.2f, 3.2f, h, 0, 3.1416f, 1.4f, 235, 773); kLine(-3.2f, my + 1.2f, 3.2f, my + 1.2f, 1.3f, 235);
      break;
    }
    case SF_DREAMY: kArc(0, my + 2.2f, 1.2f, 1 + talk, 0, 6.6f, 1.2f, 225, 774); break;
    default:
      kArc(-1.6f, my, 1.6f, 1.7f, 0.2f, 2.7f, 1.3f, 235, 775); kArc(1.6f, my, 1.6f, 1.7f, 0.2f, 2.7f, 1.3f, 235, 776);
      if (talk > 0.25f) kArc(0, my + 3.4f, 1.6f, 0.8f + talk * 1.6f, 0, 6.6f, 1.2f, 235, 777);
      break;
  }
  pFlush(G, 255);
  if (face == SF_CHEEKY) { kHatchEll(1.2f, my + 4.2f, 1.8f, 2.2f, 1.1f, 240, 778); pFlush(K_PINK, 255); kArc(1.2f, my + 4.2f, 1.8f, 2.2f, 0, 3.4f, 1.1f, 225, 779); pFlush(G, 255); }
  if ((showFlags & 2) && (showTheme == ST_XMAS || showTheme == ST_PARTY) && fabsf(kS) < 0.5f && kC > 0) kHat(t);
  // ── paws in front and the prop ──
  kSub(0, 0, 0);
  if (pose == K_PEEK) {
    for (int s = -1; s <= 1; s += 2) { kFillEll(s * 9.5f, -20, 4.4f, 3.1f); kArc(s * 9.5f, -20, 4.4f, 3.1f, 0, 6.6f, 1.5f, 235, 790 + s); kLine(s * 9.5f - 1, -18.5f, s * 9.5f - 1, -17.2f, 1.0f, 200); kLine(s * 9.5f + 1.2f, -18.5f, s * 9.5f + 1.2f, -17.2f, 1.0f, 200); }
    pFlush(G, 255);
  } else if (pose == K_SIT && pawCheek) {
    kFillEll(-11, headY + 6, 3.6f, 3); kArc(-11, headY + 6, 3.6f, 3, 0, 6.6f, 1.4f, 235, 792); pFlush(G, 255);
  }
  if (propHeld) {
    float px = pose == K_JUMP ? 17 : 13, py = pose == K_JUMP ? -36 : -17 - sinf(beatPh * 3.1416f) * 3;
    kProp(prop, px + 6, py - 9, t);
    kFillEll(px, py, 3.8f, 3); kArc(px, py, 3.8f, 3, 0, 6.6f, 1.4f, 235, 793); pFlush(G, 255);
  }
  // ── extras floating around ──
  kSub(headX, headY, 0);
  switch (face) {
    case SF_LOVE: for (int i = 0; i < 2; i++) { float p = fmodf(t * 0.55f + i * 0.5f, 1.0f); kHeart(16 + i * 6 + sinf(t * 3 + i) * 3, -14 - p * 34, 3.4f, K_PINK, (uint8_t)(255 * (1 - p)), 800 + i); } break;
    case SF_SAD: for (int s = -1; s <= 1; s += 2) { float p = fmodf(t * 1.1f + (s > 0 ? 0.5f : 0), 1.0f); kHatchEll(s * 7.5f, 4 + p * 10, 1.4f, 2.0f, 1.0f, 250, 805 + s); kArc(s * 7.5f, 4 + p * 10, 1.4f, 2.0f, 0, 6.6f, 0.9f, 220, 807 + s); pFlush(K_BLUE, (uint8_t)(255 * (1 - p * 0.7f))); } break;
    case SF_GRUMPY: for (int k = 0; k < 4; k++) { float a = k * 1.5708f + 0.785f; kArc(17 + cosf(a) * 3.4f, -14 + sinf(a) * 3.4f, 2.2f, 2.2f, a + 2.4f, 1.6f, 1.4f, 235, 810 + k); } pFlush(K_RED, 255); break;
    case SF_SURPRISED: { float j = sinf(t * 20) * 0.6f; kLine(22 + j, -24, 21 + j, -13, 2.2f, 240); kDot(20.6f + j, -8.5f, 1.6f, 240); pFlush(K_RED, 255); break; }
    case SF_EXCITED: { static const float SX[3] = {-26, 27, 22}, SY[3] = {-8, -16, 8};
      for (int k = 0; k < 3; k++) { float p = 0.55f + 0.45f * sinf(t * 6 + k * 2.1f); kSpark(SX[k], SY[k], 3.4f * p, K_YEL, 255); } break; }
    case SF_DREAMY: for (int i = 0; i < 2; i++) {
        float p = fmodf(t * 0.4f + i * 0.5f, 1.0f), x = 17 + p * 12, y = -14 - p * 26, r = 2.4f + p * 1.6f;
        kLine(x - r, y - r, x + r, y - r, 1.2f, 230); kLine(x + r, y - r, x - r, y + r, 1.2f, 230); kLine(x - r, y + r, x + r, y + r, 1.2f, 230);
        pFlush(S_GRAPH, (uint8_t)(255 * (1 - p)));
      } break;
    case SF_SINGING: for (int i = 0; i < 2; i++) {
        float p = fmodf(t * 0.6f + i * 0.5f, 1.0f), x = 20 + i * 8 + sinf(t * 4 + i) * 2, y = -8 - p * 30;
        kDot(x, y, 2, 240); kLine(x + 1.8f, y, x + 1.8f, y - 9, 1.2f, 235); kLine(x + 1.8f, y - 9, x + 5.5f, y - 6.5f, 1.2f, 235);
        pFlush(S_GRAPH, (uint8_t)(255 * (1 - p)));
      } break;
    case SF_CHEEKY: { float p = 0.5f + 0.5f * sinf(t * 5); kSpark(19, -10, 2.4f * p + 0.8f, K_YEL, 255); break; }
  }
  kSub(0, 0, 0);
}

// draw the kitten; reveal < 1 draws just the first part of its lines (being drawn on, or rubbed out)
void kittenDraw(uint8_t face, uint8_t prop, uint8_t pose, float t, float beatPh, float talk, float u, float reveal) {
  if (reveal <= 0.01f) return;
  if (reveal < 0.999f) {
    sMeasure = true; sMeasured = 0;
    kitten(face, prop, pose, t, beatPh, talk, u);
    sMeasure = false; sBudget = sMeasured * reveal;
  }
  kitten(face, prop, pose, t, beatPh, talk, u);
  sBudget = -1;
}

// ───── words ─────
#define SP_MPX 30
#define SP_LPX 44
int sCapH[2] = {0, 0}, sDesc[2] = {0, 0}, sTop[2] = {0, 0}, sBot[2] = {0, 0};
const AAFont &pFont(float sz) { return sz >= 36 ? P_L : P_M; }
int pFi(float sz) { return sz >= 36 ? 1 : 0; }
float pPx(float sz) { return sz >= 36 ? SP_LPX : SP_MPX; }
void pMetrics() {
  if (sCapH[1]) return;
  for (int f = 0; f < 2; f++) {
    const AAFont &F = f ? P_L : P_M;
    const AAGlyph *H = aaGlyph(F, 'H'), *g = aaGlyph(F, 'g');
    sCapH[f] = -H->dy; sDesc[f] = g->dy + g->h;
    int mn = 0, mx = 0;
    for (int c = F.first; c <= F.last; c++) { const AAGlyph *q = &F.g[c - F.first]; if (!q->w) continue; mn = min(mn, (int)q->dy); mx = max(mx, (int)(q->dy + q->h)); }
    sTop[f] = mn; sBot[f] = mx;
  }
}
int pAdv(const AAFont &F, const char *s, int len) { int w = 0; for (int k = 0; k < len; k++) { const AAGlyph *g = aaGlyph(F, s[k]); if (g) w += g->adv; } return w; }

struct SWordL { uint8_t st, len; float x, y, ang, sz; };
struct SLayout {
  uint8_t scene, nw, edge, rows; bool cat, sit, flip;
  SWordL w[SHOW_MAX_WORDS];
  float ax, ay, ar, as, bx, by, clipY, top, bub[4];
};
SLayout *sLays = nullptr, *sL = nullptr;
const char *sTxt = "";

float wW(int i, float sz) { const AAFont &F = pFont(sz); return pAdv(F, sTxt + sL->w[i].st, sL->w[i].len) * sz / pPx(sz); }
float rowH(float sz) { int f = pFi(sz); return (sCapH[f] + sDesc[f] * 0.55f) * sz / pPx(sz) + sz * 0.16f; }
float capOf(float sz) { return sCapH[pFi(sz)] * sz / pPx(sz); }

// fills the box with rows of words, as big as fits; returns the size used, or 0
float flowBlock(float bx0, float by0, float bx1, float by1, float maxSz, float minSz, float ang, float jitA, float jitXY, float extraRow) {
  int nw = sL->nw;
  for (float sz = maxSz; sz >= minSz - 0.01f; sz -= 2) {
    float gap = sz * 0.3f, rh = rowH(sz) + extraRow, bw = bx1 - bx0, x = 0;
    float rowW[SHOW_MAX_WORDS]; int rowOf[SHOW_MAX_WORDS], row = 0; bool ok = true;
    for (int i = 0; i < nw; i++) {
      float w = wW(i, sz);
      if (w > bw) { ok = false; break; }
      if (x > 0 && x + gap + w > bw) { row++; x = 0; }
      rowOf[i] = row; x += (x > 0 ? gap : 0) + w; rowW[row] = x;
    }
    if (!ok) continue;
    int rows = row + 1;
    float th = rows * rh - extraRow;
    if (th > by1 - by0) continue;
    float cx = (bx0 + bx1) / 2, cy = (by0 + by1) / 2, y0 = cy - th / 2 + (rh - extraRow) / 2, xs[SHOW_MAX_WORDS];
    for (int r = 0; r < rows; r++) xs[r] = cx - rowW[r] / 2;
    float ca = cosf(ang), sa = sinf(ang), mnx = 999, mxx = -999;
    for (int i = 0; i < nw; i++) {
      int r = rowOf[i]; float w = wW(i, sz), x = xs[r] + w / 2, y = y0 + r * rh;
      xs[r] += w + gap;
      mnx = fminf(mnx, x - w / 2); mxx = fmaxf(mxx, x + w / 2);
      float dx = x - cx, dy = y - cy;
      SWordL &W = sL->w[i];
      W.x = cx + dx * ca - dy * sa + sRr(-jitXY, jitXY);
      W.y = cy + dx * sa + dy * ca + sRr(-jitXY, jitXY);
      W.ang = ang + sRr(-jitA, jitA); W.sz = sz;
    }
    sL->rows = rows;
    sL->top = y0 - capOf(sz) / 2;
    sL->bub[0] = mnx; sL->bub[1] = sL->top; sL->bub[2] = mxx; sL->bub[3] = y0 + (rows - 1) * rh + capOf(sz) / 2 + sDesc[pFi(sz)] * sz / pPx(sz) * 0.5f;
    return sz;
  }
  return 0;
}
// words round the top of an ellipse, like writing curving over the kitten's head
bool ringLayout(float cx, float cy, float rx, float ry, float T) {
  // done in double so the website (JavaScript numbers are doubles) lands every word on the same pixel
  int nw = sL->nw;
  for (float sz = 40; sz >= 22; sz -= 2) {
    double gap = sz * 0.3f, need = 0;
    for (int i = 0; i < nw; i++) need += wW(i, sz) + (i ? gap : 0);
    const double dt = 0.02;
    double half = need / 2, acc = 0, th = -1.5708;
    double ds = 0;
    while (acc < half && th > -1.5708 - 2.5) { th -= dt; ds = dt * sqrt((double)rx * rx * sin(th) * sin(th) + (double)ry * ry * cos(th) * cos(th)); acc += ds; }
    if (acc < half) continue;                         // more than about 290 degrees: too long, go smaller
    th += dt * (acc - half) / ds;                     // step back to exactly half way (keeps tiny rounding from jumping a whole step)
    double pos = 0;
    bool fits = true;
    for (int i = 0; i < nw; i++) {
      double w = wW(i, sz), target = pos + w / 2, a = th, s = 0;
      double st = 0;
      while (s < target) { a += dt; st = dt * sqrt((double)rx * rx * sin(a) * sin(a) + (double)ry * ry * cos(a) * cos(a)); s += st; }
      if (st > 0) a -= dt * (s - target) / st;
      SWordL &W = sL->w[i];
      W.x = cx + cos(a) * rx; W.y = cy + sin(a) * ry;
      W.ang = sClamp(atan2((double)ry * cos(a), -(double)rx * sin(a)), -1.0f, 1.0f);
      W.sz = sz;
      float ex = fabsf(cosf(W.ang)) * w / 2 + fabsf(sinf(W.ang)) * sz * 0.4f;
      if (W.x - ex < 2 || W.x + ex > SCR_W - 2 || W.y < T + 6 || W.y > 262) fits = false;
      pos += w + gap;
    }
    if (fits) return true;
  }
  return false;
}

void sSplit(int li) {
  const char *s = showLine[li].text; int n = 0;
  for (int i = 0; s[i] && n < SHOW_MAX_WORDS;) {
    while (s[i] == ' ') i++;
    if (!s[i]) break;
    int st = i; while (s[i] && s[i] != ' ') i++;
    sL->w[n].st = st; sL->w[n].len = i - st; n++;
  }
  sL->nw = n;
}
int sWords(int li) { int n = 0; bool in = false; for (const char *p = showLine[li].text; *p; p++) { if (*p != ' ' && !in) { n++; in = true; } else if (*p == ' ') in = false; } return min(n, SHOW_MAX_WORDS); }

bool sceneLayout(int li, uint8_t sc) {
  SLayout &L = *sL;
  int nw = L.nw;
  float T = showTheme == ST_XMAS ? 34 : 16;             // keep clear of the fairy lights
  L.scene = sc; L.cat = true; L.flip = false; L.ar = 0; L.as = 1; L.clipY = 9999; L.edge = 0;
  L.sit = sc == SS_RING || sc == SS_BIG || sc == SS_HOP || sc == SS_BUBBLE;
  switch (sc) {
    case SS_WORDS:
      L.cat = false;
      return flowBlock(12, T, 228, 258, 60, 20, sRr(-0.16f, 0.16f), 0.14f, 6, 4) > 0;
    case SS_RING: {
      L.as = sRr(1.4f, 1.65f); L.ax = 120 + sRr(-16, 16); L.ay = sRr(222, 246); L.flip = sRf() < 0.5f;
      float cy = L.ay - 46 * L.as;
      float rx = sRr(70, 82), ry = sRr(72, 86);           // in this order: the website draws the same numbers
      return ringLayout(L.ax, cy, rx, fminf(cy - T - 8, ry), T);
    }
    case SS_PEEK: {
      float r = sRf(); L.edge = r < 0.5f ? 0 : r < 0.68f ? 1 : r < 0.86f ? 2 : 3;
      L.as = sRr(1.6f, 1.95f); float h = 58 * L.as;
      if (L.edge == 0) { L.ax = sRr(64, 176); L.ay = SCR_H + 19 * L.as; return flowBlock(14, T, 226, SCR_H - h - 4, 50, 18, sRr(-0.1f, 0.1f), 0.06f, 3, 0) > 0; }
      if (L.edge == 1) { L.ar = 1.5708f; L.ax = -19 * L.as; L.ay = sRr(80, 200); return flowBlock(h + 2, T, 228, 262, 46, 18, sRr(-0.1f, 0.1f), 0.06f, 3, 0) > 0; }
      if (L.edge == 2) { L.ar = -1.5708f; L.ax = SCR_W + 19 * L.as; L.ay = sRr(80, 200); return flowBlock(12, T, SCR_W - h - 2, 262, 46, 18, sRr(-0.1f, 0.1f), 0.06f, 3, 0) > 0; }
      L.ar = 3.1416f; L.ax = sRr(64, 176); L.ay = -19 * L.as; return flowBlock(14, h + 4, 226, 262, 50, 18, sRr(-0.1f, 0.1f), 0.06f, 3, 0) > 0;
    }
    case SS_STROLL: {
      L.flip = sRf() < 0.5f; L.as = sRr(1.25f, 1.45f); L.ay = sRr(250, 264);
      L.ax = L.flip ? SCR_W + 40 : -40; L.bx = L.flip ? -40 : SCR_W + 40; L.by = L.ay;
      return flowBlock(14, T, 226, L.ay - 46 * L.as, 50, 18, sRr(-0.14f, 0.14f), 0.08f, 4, 2) > 0;
    }
    case SS_BIG: {
      L.cat = sRf() < 0.65f;
      float yl = T + 28, yh = L.cat ? 160 : 214;
      for (int i = 0; i < nw; i++) {
        float sz = 74, w = wW(i, SP_LPX) * 74 / SP_LPX;
        if (w > 214) { sz = 74 * 214 / w; w = 214; }
        if (sz < 12) sz = 12;
        SWordL &W = L.w[i]; W.sz = sz;
        W.x = sRr(14 + w / 2, 226 - w / 2); if (w >= 212) W.x = 120;
        W.y = sRr(yl, yh); W.ang = sRr(-0.24f, 0.24f);
      }
      L.ax = sRf() < 0.5f ? 62 : 178; L.ay = 264; L.bx = 240 - L.ax; L.by = 264; L.as = 1.3f;
      return true;
    }
    case SS_HIDE: {
      if (!flowBlock(14, 118, 226, 262, 52, 18, 0, 0.04f, 2, 0)) return false;
      L.as = sRr(1.45f, 1.7f); L.ax = sRr(64, 176); L.clipY = L.top + 3; L.ay = L.clipY + 19 * L.as;
      return true;
    }
    case SS_HOP: {
      if (!flowBlock(14, T + 46, 226, 262, 40, 18, 0, 0.08f, 4, 34)) return false;
      if (L.rows > 4) return false;
      L.as = 0.85f;
      return true;
    }
    case SS_BUBBLE: {
      L.flip = sRf() < 0.5f; L.as = 1.3f; L.ax = L.flip ? 178 : 62; L.ay = 266;
      if (!flowBlock(28, T + 10, 212, 158, 42, 18, 0, 0.05f, 2, 0)) return false;
      L.bub[0] -= 12; L.bub[1] -= 12; L.bub[2] += 12; L.bub[3] += 10;
      return true;
    }
  }
  return false;
}

void buildLayouts() {
  if (!sLays) sLays = (SLayout *)ps_malloc(sizeof(SLayout) * SHOW_MAX_LINES);
  if (!sLays) return;
  pMetrics();
  int prev = -1, withCat = 0;
  for (int li = 0; li < showN; li++) {
    sL = &sLays[li]; sTxt = showLine[li].text;
    sSplit(li);
    uint32_t h = sFnv(sTxt) ^ (uint32_t)(li * 0x9E3779B9U);
    sRs = h ? h : 1;
    int nw = sL->nw;
    uint8_t sc = showLine[li].scene;
    if (sc == SS_AUTO) {
      static const uint8_t C1[] = {SS_BIG, SS_HOP, SS_PEEK, SS_RING, SS_BIG};
      static const uint8_t C3[] = {SS_RING, SS_BIG, SS_HOP, SS_PEEK, SS_WORDS, SS_HIDE};
      static const uint8_t C7[] = {SS_RING, SS_PEEK, SS_HIDE, SS_BUBBLE, SS_STROLL, SS_WORDS, SS_HOP};
      static const uint8_t C9[] = {SS_PEEK, SS_BUBBLE, SS_STROLL, SS_WORDS, SS_HIDE};
      const uint8_t *C; int cn;
      if (nw <= 1) { C = C1; cn = 5; } else if (nw <= 3) { C = C3; cn = 6; } else if (nw <= 7) { C = C7; cn = 7; } else { C = C9; cn = 5; }
      int k = (int)(sRf() * cn);
      uint8_t f = showLine[li].face, want = f == SF_EXCITED ? SS_HOP : f == SF_SHY ? SS_HIDE : f == SF_SINGING ? SS_BUBBLE : f == SF_DREAMY ? SS_STROLL : 255;
      if (want != 255 && sRf() < 0.5f) for (int q = 0; q < cn; q++) if (C[q] == want) k = q;
      sc = C[k];
      if (sc == prev) sc = C[(k + 1) % cn];
      if (withCat >= 3) sc = nw <= 3 ? SS_BIG : SS_WORDS;
    }
    if (!sceneLayout(li, sc)) { sRs = h ? h : 1; if (!sceneLayout(li, SS_PEEK) && !sceneLayout(li, SS_WORDS)) { sceneLayout(li, SS_BIG); sL->cat = false; } }
    if (sc == SS_BIG && withCat >= 3) sL->cat = false;
    withCat = sL->cat ? withCat + 1 : 0;
    prev = sL->scene;
  }
  sLayOK = true;
}

// render one word into the small word buffer; returns its width and baseline
int sWbW = 0, sWbH = 0, sWbBase = 0, sWbAdv = 0;
void renderWord(const AAFont &F, int fi, const char *s, int len, int seed) {
  const int pad = 4;
  sWbBase = pad - sTop[fi]; sWbH = sWbBase + sBot[fi] + pad + 1;
  if (sWbH > SW_H) sWbH = SW_H;
  sWbW = min(SW_W, pad + pAdv(F, s, len) + pad + 4);
  for (int y = 0; y < sWbH; y++) memset(sWord + y * SW_W, 0, sWbW);
  int x = pad;
  for (int k = 0; k < len; k++) {
    const AAGlyph *g = aaGlyph(F, s[k]);
    if (!g) continue;
    int jx = (int)roundf(sJit(seed * 31 + k, 5) * 0.8f), jy = (int)roundf(sJit(seed * 31 + k, 6) * 1.0f);
    const uint8_t *bmp = F.bmp + g->off;
    int rb = (g->w + 1) / 2;
    for (int j = 0; j < g->h; j++) {
      int yy = sWbBase + g->dy + j + jy;
      if (yy < 0 || yy >= sWbH) continue;
      uint8_t *row = sWord + yy * SW_W;
      for (int i = 0; i < g->w; i++) {
        int xx = x + g->dx + i + jx;
        if (xx < 0 || xx >= sWbW) continue;
        uint8_t v = bmp[j * rb + (i >> 1)];
        v = (i & 1) ? (v & 15) : (v >> 4);
        v = v * 17;
        if (v > row[xx]) row[xx] = v;
      }
    }
    x += g->adv;
  }
  sWbAdv = x - pad;
}
// copy the word buffer into the pencil layer, centred at (x, y), turned and scaled; reveal writes it left to right
void blitWord(float x, float y, float ang, float sc, float alpha, float reveal, int fi) {
  float c = cosf(ang), s = sinf(ang);
  float ax = 4 + sWbAdv / 2.0f, ay = sWbBase - sCapH[fi] / 2.0f;
  float mnx = 1e9f, mxx = -1e9f, mny = 1e9f, mxy = -1e9f;
  for (int k = 0; k < 4; k++) {
    float cu = ((k & 1) ? sWbW : 0) - ax, cv = ((k & 2) ? sWbH : 0) - ay;
    float X = x + (cu * c - cv * s) * sc, Y = y + (cu * s + cv * c) * sc;
    mnx = fminf(mnx, X); mxx = fmaxf(mxx, X); mny = fminf(mny, Y); mxy = fmaxf(mxy, Y);
  }
  int x0 = max(0, (int)floorf(mnx)), x1 = min(SCR_W - 1, (int)ceilf(mxx)), y0 = max(0, (int)floorf(mny)), y1 = min(SCR_H - 1, (int)ceilf(mxy));
  if (y1 >= sClipY) y1 = (int)ceilf(sClipY) - 1;
  float uMax = 4 + sWbAdv * reveal + 2, isc = 1 / sc;
  int A = (int)(alpha * 256);
  if (A <= 0) return;
  bool any = false;
  for (int py = y0; py <= y1; py++) {
    float dy = py - y;
    uint8_t *row = sLayer + py * SCR_W;
    for (int px = x0; px <= x1; px++) {
      float dx = px - x;
      float u = ax + (dx * c + dy * s) * isc, v = ay + (-dx * s + dy * c) * isc;
      if (u < 0 || v < 0 || u >= sWbW - 1 || v >= sWbH - 1 || u > uMax) continue;
      int iu = (int)u, iv = (int)v; float fu = u - iu, fv = v - iv;
      const uint8_t *p = sWord + iv * SW_W + iu;
      float val = (p[0] * (1 - fu) + p[1] * fu) * (1 - fv) + (p[SW_W] * (1 - fu) + p[SW_W + 1] * fu) * fv;
      int vv = ((int)val * A) >> 8;
      if (vv > row[px]) { row[px] = vv > 255 ? 255 : vv; any = true; }
    }
  }
  if (any) { if (x0 < sDx0) sDx0 = x0; if (x1 > sDx1) sDx1 = x1; if (y0 < sDy0) sDy0 = y0; if (y1 > sDy1) sDy1 = y1; }
}
void drawWord(int li, int i, float x, float y, float ang, float sz, float alpha, float reveal) {
  SWordL &W = sLays[li].w[i];
  const AAFont &F = pFont(sz); int fi = pFi(sz);
  renderWord(F, fi, showLine[li].text + W.st, W.len, li * 64 + i);
  blitWord(x, y, ang, sz / pPx(sz), alpha, reveal, fi);
}

// the words of a line at beat u (float, beats since the line started)
void singWords(int li, float u, float t, int dur) {
  SLayout &L = sLays[li];
  int n = L.nw;
  float fade = 1 - sClamp((u - (dur - 0.6f)) / 0.6f, 0, 1);
  float drx = sinf(t * 0.6f + li) * 3, dry = cosf(t * 0.5f + li * 2) * 2.5f;
  if (L.scene == SS_BIG) {
    int k = min((int)u, n - 1);
    for (int i = max(0, k - 1); i <= k; i++) {
      SWordL &W = L.w[i];
      float pp = u - i, a = fade, sc = 1, rev = 1;
      if (i < k) { float q = sClamp((u - k) / 0.3f, 0, 1); if (q >= 1) continue; a *= 1 - q; sc = 1 - 0.3f * q; }
      else { rev = sClamp(pp / 0.3f, 0, 1); sc = 1 + 0.35f * (1 - sEase(pp / 0.35f)); }
      drawWord(li, i, W.x + drx, W.y + dry + sinf(t * 2.1f + i) * 2, W.ang + sinf(t * 1.7f + i) * 0.03f, W.sz * sc, a, rev);
    }
    return;
  }
  for (int i = 0; i < n && i <= (int)u; i++) {
    SWordL &W = L.w[i];
    float pp = u - i, rev = sClamp(pp / 0.3f, 0, 1), e = sEase(pp / 0.4f);
    float sc = 1 + 0.22f * (1 - e), ox = 0, oy = -7 * (1 - e);
    if (L.scene == SS_WORDS) { float a = sHf(li * 64 + i, 9) * 6.2832f; ox = cosf(a) * 26 * (1 - e); oy = sinf(a) * 26 * (1 - e); }
    float bob = sinf(t * 2.2f + i * 1.3f) * 1.3f, sway = sinf(t * 1.7f + i) * 0.025f;
    float dx = L.scene == SS_HIDE || L.scene == SS_BUBBLE ? 0 : drx, dy = L.scene == SS_HIDE || L.scene == SS_BUBBLE ? 0 : dry;
    drawWord(li, i, W.x + ox + dx, W.y + oy + dy + bob, W.ang + sway, W.sz * sc, fade, rev);
  }
}

// the speech bubble, drawn on at the start of the line
void singBubble(int li, float u, int dur) {
  SLayout &L = sLays[li];
  float x0 = L.bub[0], y0 = L.bub[1], x1 = L.bub[2], y1 = L.bub[3], r = 14;
  float tipx = L.ax + (L.flip ? -6 : 6), tipy = L.ay - 66 * L.as, tbx = L.flip ? x1 - 34 : x0 + 34;
  if (tbx < x0 + r) tbx = x0 + r; if (tbx > x1 - r - 14) tbx = x1 - r - 14;
  float px[48], py[48]; int n = 0;
  for (int c = 0; c < 4; c++) {                          // rounded corners
    float cx = c == 0 || c == 3 ? x0 + r : x1 - r, cy = c < 2 ? y0 + r : y1 - r, a0 = 3.1416f + c * 1.5708f;
    for (int k = 0; k <= 4; k++) { float a = a0 + 1.5708f * k / 4; px[n] = cx + cosf(a) * r; py[n] = cy + sinf(a) * r; n++; }
    if (c == 2) { px[n] = tbx + 16; py[n] = y1; n++; px[n] = tipx; py[n] = tipy; n++; px[n] = tbx; py[n] = y1; n++; }
  }
  float fade = 1 - sClamp((u - (dur - 0.6f)) / 0.6f, 0, 1), rev = sClamp(u / 0.5f, 0, 1);
  if (rev >= 1) pFill(px, py, n, sPaperCol);
  float tot = 0; for (int i = 0; i < n; i++) { int j = (i + 1) % n; tot += sqrtf((px[j] - px[i]) * (px[j] - px[i]) + (py[j] - py[i]) * (py[j] - py[i])); }
  if (rev < 1) sBudget = tot * rev;
  for (int i = 0; i < n; i++) { int j = (i + 1) % n; pSeg(px[i] + sJit(901, i) * 0.6f, py[i] + sJit(902, i) * 0.6f, px[j] + sJit(901, j) * 0.6f, py[j] + sJit(902, j) * 0.6f, 1.9f, 235); }
  sBudget = -1;
  pFlush(S_GRAPH, (uint8_t)(255 * fade));
}

// ───── paper and the season ─────
const uint16_t S_PAPER[ST_COUNT] = {c565(251, 246, 236), c565(253, 238, 241), c565(245, 241, 253), c565(252, 252, 247)};
void buildPaper() {
  uint16_t *keep = FB; FB = sPaper;
  sPaperCol = S_PAPER[showTheme % ST_COUNT];
  for (int y = 0; y < SCR_H; y++) for (int x = 0; x < SCR_W; x++) {
    uint32_t h = sHash((uint32_t)(x * 911 + y * 3067 + 7));
    int d = (int)(h & 7) - 3 - (((h >> 5) & 63) == 0 ? 6 : 0);
    uint16_t c = sPaperCol;
    FB[y * SCR_W + x] = d < 0 ? mix565(c, c565(120, 110, 100), (uint8_t)(-d * 5)) : mix565(c, COL_WHITE, (uint8_t)(d * 14));
  }
  if (showTheme == ST_PLAIN) {                           // notebook paper
    for (int y = 34; y < SCR_H; y += 24) pSeg(0, y, SCR_W - 1, y + sJit(y, 1) * 0.3f, 1.0f, 150);
    pFlush(c565(140, 186, 232), 255);
    pSeg(26, 0, 26.5f, SCR_H - 1, 1.0f, 170); pFlush(c565(236, 120, 130), 255);
  } else {                                              // a few faint doodles in the background
    for (int i = 0; i < 9; i++) {
      float x = 14 + sHf(i, 21) * 212, y = 14 + sHf(i, 22) * 250, r = 3 + sHf(i, 23) * 3;
      kTx = x; kTy = y; kC = 1; kS = 0; kSc = 1; kFlip = false; kSub(0, 0, 0);
      if (showTheme == ST_LOVE) { float lx[12], ly[12]; kHeartPts(0, 0, r, lx, ly); for (int k = 0; k < 12; k++) kLine(lx[k], ly[k], lx[(k + 1) % 12], ly[(k + 1) % 12], 1.0f, 150); pFlush(K_PINK, 120); }
      else if (showTheme == ST_PARTY) { kLine(-r, 0, -r / 3, -r / 2, 1.1f, 160); kLine(-r / 3, -r / 2, r / 3, 0, 1.1f, 160); kLine(r / 3, 0, r, -r / 2, 1.1f, 160); static const uint16_t CC[3] = {c565(240, 110, 150), c565(92, 148, 228), c565(238, 182, 36)}; pFlush(CC[i % 3], 120); }
      else { for (int k = 0; k < 3; k++) { float a = k * 1.0472f; kLine(-cosf(a) * r, -sinf(a) * r, cosf(a) * r, sinf(a) * r, 1.0f, 150); } pFlush(c565(150, 180, 220), 120); }
    }
  }
  FB = keep;
  sPaperTheme = showTheme;
}
void singSeason(float t, int beatN, bool front) {
  kC = 1; kS = 0; kSc = 1; kFlip = false; kSub(0, 0, 0);
  if (showTheme == ST_XMAS) {
    if (!front) {                                        // fairy lights scribbled along the top
      float px = -6, py = 10;
      for (int i = 1; i <= 12; i++) { float x = -6 + i * 21, u = (x - 120) / 130.0f, y = 10 + (1 - u * u) * 12; pSeg(px, py + sJit(i, 3) * 0.5f, x, y, 1.3f, 220); px = x; py = y; }
      pFlush(S_GRAPH, 255);
      static const uint16_t BULB[4] = {K_RED, K_GRN, K_YEL, K_BLUE};
      for (int i = 0; i < 11; i++) {
        float x = 10 + i * 22, u = (x - 120) / 130.0f, y = 10 + (1 - u * u) * 12 + 6;
        bool on = ((i + beatN) % 3) != 0;
        kTx = x; kTy = y;
        if (on) { kHatchEll(0, 0, 3.4f, 4.6f, 1.5f, 240, 950 + i); pFlush(BULB[i % 4], 255); }
        kArc(0, 0, 3.4f, 4.6f, 0, 6.6f, 1.2f, 220, 960 + i); pFlush(S_GRAPH, 255);
      }
    }
    for (int i = front ? 7 : 0; i < (front ? 14 : 7); i++) {    // snowflakes drifting down
      float sp = 14 + sHf(i, 31) * 16, y = fmodf(t * sp + sHf(i, 32) * 300, 300) - 10, x = 10 + sHf(i, 33) * 220 + sinf(t * 0.8f + i) * 8;
      kTx = x; kTy = y; kSub(0, 0, t * 0.7f + i);
      float r = front ? 4.5f : 3;
      for (int k = 0; k < 3; k++) { float a = k * 1.0472f; kLine(-cosf(a) * r, -sinf(a) * r, cosf(a) * r, sinf(a) * r, 1.1f, 230); }
      pFlush(c565(120, 160, 215), 255);
    }
  } else if (showTheme == ST_LOVE && !front) {
    for (int i = 0; i < 7; i++) {
      float p = fmodf(t * 0.1f + sHf(i, 41), 1.0f), x = 16 + sHf(i, 42) * 208 + sinf(t * 1.4f + i) * 7, y = SCR_H + 12 - p * (SCR_H + 30);
      kTx = x; kTy = y; kSub(0, 0, sinf(t + i) * 0.2f);
      kHeart(0, 0, 4 + sHf(i, 43) * 3, K_PINK, (uint8_t)(220 * (1 - p * 0.6f)), 970 + i);
    }
  } else if (showTheme == ST_PARTY && front) {
    static const uint16_t CC[5] = {c565(240, 100, 140), c565(92, 148, 228), c565(238, 182, 36), c565(64, 158, 92), c565(170, 110, 230)};
    for (int i = 0; i < 12; i++) {
      float sp = 22 + sHf(i, 51) * 22, y = fmodf(t * sp + sHf(i, 52) * 300, 300) - 10, x = 8 + sHf(i, 53) * 224 + sinf(t * 2 + i) * 6;
      kTx = x; kTy = y; kSub(0, 0, t * 3 + i);
      kLine(-4, 0, -1.3f, -2, 1.5f, 230); kLine(-1.3f, -2, 1.3f, 0, 1.5f, 230); kLine(1.3f, 0, 4, -2, 1.5f, 230);
      pFlush(CC[i % 5], 255);
    }
  } else if (showTheme == ST_PLAIN && front) {
    for (int i = 0; i < 4; i++) { float p = 0.5f + 0.5f * sinf(t * 2.4f + i * 1.7f); kTx = 10 + sHf(i, 61) * 14; kTy = 40 + i * 60 + sHf(i, 62) * 20; kSpark(0, 0, 2 + 2.6f * p, S_GRAPH, 200); }
  }
}

// where the kitten is at beat u of line li (its own scene only, no entrances)
float kX, kY, kR, kSs, kRev, kHop; uint8_t kPose; bool kFl;
void catAt(int li, float u, float t) {
  SLayout &L = sLays[li];
  int dur = L.nw + 2;
  kX = L.ax; kY = L.ay; kR = L.ar; kSs = L.as; kFl = L.flip; kPose = K_SIT; kRev = 1; kHop = 0;
  switch (L.scene) {
    case SS_RING: kX += sinf(t * 0.9f + li) * 6; break;
    case SS_BIG: {
      float half = (L.nw + 1) / 2.0f, q = sClamp((u - half) / 0.6f, 0, 1);
      if (L.nw >= 3 && q > 0) {
        kX = L.ax + (L.bx - L.ax) * sEase(q); kHop = sinf(q * 3.1416f) * 34; kFl = L.bx < L.ax;
        if (q < 1) kPose = K_JUMP;
      }
      break;
    }
    case SS_HOP: {
      int n = L.nw, k = (int)floorf(u + 0.45f); if (k > n - 1) k = n - 1; if (k < 0) k = 0;
      SWordL &W = L.w[k];
      float top = W.y - capOf(W.sz) / 2 - 1;
      kX = W.x; kY = top;
      float q = (u - (k - 0.45f)) / 0.45f;
      if (k > 0 && q < 1) {
        SWordL &P = L.w[k - 1];
        float ptop = P.y - capOf(P.sz) / 2 - 1, e = sEase(q);
        kX = P.x + (W.x - P.x) * e; kY = ptop + (top - ptop) * e; kHop = sinf(q * 3.1416f) * 30; kFl = W.x < P.x; kPose = K_JUMP;
      }
      break;
    }
    case SS_BUBBLE: break;
    case SS_STROLL: {
      float p = u / dur; kX = L.ax + (L.bx - L.ax) * p; kY = L.ay - fabsf(sinf(t * 9)) * 2; kPose = K_WALK; break;
    }
    case SS_PEEK: case SS_HIDE: {
      float in = sEase(u / 0.6f) * (1 - sEase((u - (dur - 0.7f)) / 0.6f));
      float pop = 0; int k = (int)u; if (k < L.nw) pop = 1 - sClamp((u - k) / 0.6f, 0, 1);
      float h = L.scene == SS_HIDE ? in * (0.5f + 0.5f * pop) : in * (0.85f + 0.15f * pop);
      float back = (1 - h) * 48 * L.as;
      kX = L.ax - sinf(L.ar) * back; kY = L.ay + cosf(L.ar) * back;
      kPose = K_PEEK;
      break;
    }
  }
}

void singCat(int li, float u, float t, float ph, float talk) {
  SLayout &L = sLays[li];
  if (!L.cat) return;
  int dur = L.nw + 2, pv = (li + showN - 1) % showN, nx = (li + 1) % showN;
  SLayout &P = sLays[pv], &N = sLays[nx];
  catAt(li, u, t);
  float rev = 1;
  if (L.sit) {
    bool travel = P.cat && P.sit && pv != li;
    bool leave = !(N.cat && N.sit && nx != li);
    if (u < 0.7f) {
      if (travel) {
        float X = kX, Y = kY, R = kR, Ss = kSs; bool F = kFl;
        catAt(pv, P.nw + 2, t);
        float e = sEase(u / 0.7f);
        kHop = sinf(e * 3.1416f) * 40; kFl = X < kX;
        kX = kX + (X - kX) * e; kY = kY + (Y - kY) * e; kR = kR + (R - kR) * e; kSs = kSs + (Ss - kSs) * e;
        kPose = e < 0.97f ? K_JUMP : kPose;
        if (e >= 0.97f) kFl = F;
      } else rev = u / 0.7f;
    }
    if (leave && u > dur - 0.7f) rev = fminf(rev, (dur - u) / 0.7f);
  }
  float jump = 0;
  if (singJumpAt && millis() - singJumpAt < 600) jump = sinf((millis() - singJumpAt) / 600.0f * 3.1416f) * 36;
  float up = kHop + jump;
  kTx = kX + sinf(kR) * up; kTy = kY - cosf(kR) * up;
  kC = cosf(kR); kS = sinf(kR); kSc = kSs; kFlip = kFl;
  if (up > 4 && kPose == K_SIT) kPose = K_JUMP;
  sClipY = L.clipY;
  kittenDraw(showLine[li].face, showLine[li].prop, kPose, t, ph, talk, u, sClamp(rev, 0, 1));
  sClipY = 9999;
}

void drawSing() {
  if (!showLoaded) singLoad();
  if (!showN) showDefault();
  if (!singBuffers()) { gfx->fillScreen(COL_BLACK); return; }
  if (!sLayOK) buildLayouts();
  if (!sLayOK) { gfx->fillScreen(COL_BLACK); return; }
  uint32_t now = singPaused ? singPausedAt : millis();
  if (!singT0) singT0 = now;
  sBoil = (millis() / 110) % 4096;
  float t = millis() / 1000.0f;
  uint32_t beat = 60000UL / max<uint8_t>(40, showBpm);
  uint32_t total = 0;
  for (int i = 0; i < showN; i++) total += (sLays[i].nw + 2) * beat;
  uint32_t el = (now - singT0) % max<uint32_t>(1, total);
  int li = 0;
  while (li < showN - 1 && el >= (uint32_t)(sLays[li].nw + 2) * beat) { el -= (sLays[li].nw + 2) * beat; li++; }
  SLayout &L = sLays[li];
  int dur = L.nw + 2, bi = el / beat;
  float u = el / (float)beat, ph = (el % beat) / (float)beat;
  int popIdx = bi < L.nw ? bi : -1;
  float talk = popIdx >= 0 ? fmaxf(0, 1 - (el % beat) / 170.0f) : 0;
  int wordId = li * 64 + bi;
  if (popIdx >= 0 && wordId != singLastWord) {
    singLastWord = wordId;
    if ((showFlags & 1) && soundsOn && !jbPlaying && !singPaused) {   // a goofy little voice blip per word
      static const uint16_t PENTA[6] = {784, 880, 1047, 1175, 1319, 1568};
      uint8_t f = showLine[li].face;
      uint16_t hz = PENTA[sHash(wordId * 13 + li) % 6];
      if (f == SF_SAD || f == SF_DREAMY) hz = hz * 2 / 3; else if (f == SF_EXCITED || f == SF_SURPRISED) hz = hz * 4 / 3;
      tone(BUZZER, hz, 45);
    }
  }
  if (sPaperTheme != showTheme) buildPaper();
  memcpy(FB, sPaper, SCR_W * SCR_H * 2);
  sClipY = 9999; sBudget = -1; sMeasure = false;
  singSeason(t, (int)((now - singT0) / beat), false);
  uint16_t ink = showLine[li].own ? showLine[li].col : showInk;
  if (L.scene == SS_HIDE) {
    singCat(li, u, t, ph, talk);
    singWords(li, u, t, dur); pFlush(ink, 255);
  } else {
    if (L.scene == SS_BUBBLE) singBubble(li, u, dur);
    singWords(li, u, t, dur); pFlush(ink, 255);
    singCat(li, u, t, ph, talk);
  }
  singSeason(t, 0, true);
  // which line we are on, as little pencil dots
  for (int i = 0; i < showN; i++) {
    float x = 120 - showN * 4.0f + i * 8 + 4;
    pSeg(x, 273, x, 273, i == li ? 4.6f : 2.6f, i == li ? 230 : 120);
  }
  pFlush(S_GRAPH, 255);
  if (singPaused) {
    for (int k = 0; k < 2; k++) for (int j = 0; j < 4; j++) pSeg(110 + k * 18 + j * 1.6f + sJit(k, j), 124, 110 + k * 18 + j * 1.6f + sJit(k, j + 9), 156, 1.6f, 235);
    pFlush(S_GRAPH, 255);
  }
}

void singTap() {
  if (singPaused) { singT0 += millis() - singPausedAt; singPaused = false; }
  else { singPaused = true; singPausedAt = millis(); }
}
void singSkip(int dir) {                               // jump to the next or previous line
  if (!showN) return;
  uint32_t beat = 60000UL / max<uint8_t>(40, showBpm), total = 0, starts[SHOW_MAX_LINES];
  for (int i = 0; i < showN; i++) { starts[i] = total; total += (sWords(i) + 2) * beat; }
  uint32_t now = singPaused ? singPausedAt : millis(), el = (now - singT0) % max<uint32_t>(1, total);
  int li = 0; while (li < showN - 1 && el >= starts[li + 1]) li++;
  int to = (li + dir + showN) % showN;
  singT0 = now - starts[to];
  singLastWord = -1;
}
// ───────────── Screen effects ─────────────
void scanlines() {
  if (!FB) return;
  for (int y = 1; y < SCR_H; y += 2) {
    uint16_t *p = FB + y * SCR_W;
    for (int x = 0; x < SCR_W; x++) p[x] -= (p[x] >> 2) & 0x39E7;
  }
}

// tears a few bands of the frame sideways
void glitchFx(int bands) {
  if (!FB) return;
  static uint16_t rowTmp[SCR_W];
  for (int b = 0; b < bands; b++) {
    int y = random(0, SCR_H - 16), h = random(2, 14), off = random(-28, 29);
    if (off == 0) continue;
    for (int j = 0; j < h; j++) {
      uint16_t *row = FB + (y + j) * SCR_W;
      memcpy(rowTmp, row, SCR_W * 2);
      for (int x = 0; x < SCR_W; x++) row[x] = rowTmp[(x - off + SCR_W) % SCR_W];
    }
  }
  gfx->drawFastHLine(0, random(0, SCR_H), SCR_W, ACC);
}

// old-TV switch-on when the screen wakes
void wakeFx() {
  if (!wakeFxAt) return;
  uint32_t el = millis() - wakeFxAt;
  if (el > 260) { wakeFxAt = 0; return; }
  float t = el / 260.0f;
  int half = 2 + (int)(t * t * 138);
  gfx->fillRect(0, 0, SCR_W, 140 - half, COL_BLACK);
  gfx->fillRect(0, 140 + half, SCR_W, 140 - half, COL_BLACK);
  gfx->drawFastHLine(0, 140 - half, SCR_W, COL_WHITE);
  gfx->drawFastHLine(0, 140 + half - 1, SCR_W, COL_WHITE);
}

void drawScene() {
  switch (mode) {
    case M_CLOCK: drawClock(); break;
    case M_TEXT:  drawText();  break;
    case M_PHOTO: drawPhoto(); break;
    case M_SING:  drawSing(); break;
    case M_MUSIC: drawMusic(); break;
    case M_PET:   drawPet();   break;
    case M_TOY:   drawToy();   break;
    case M_CARD:  drawCard();  break;
    case M_EYES:  drawEyes();  break;
    case M_JUKE:  drawJuke();  break;
    case M_TORCH: drawTorch(); break;
    case M_CHARGE: drawCharge(); break;
    default:      drawDeck(); break;
  }
}

void render() {
  updateAccent();
  drawScene();
  if (mode == M_CLOCK || mode == M_PET || mode == M_TOY || mode == M_CARD) drawTicker();
  bool fx = fxOn;
  if (fx && mode != M_PHOTO && mode != M_SING && mode != M_MUSIC && mode != M_TORCH) scanlines();
  if (glitchFrames) { glitchFx(5); glitchFrames--; }
  else if (fx && mode == M_DECK && random(0, 220) == 0) glitchFrames = 2;
  drawAlarm();
  drawTransferOverlay();
  drawToast();
  wakeFx();
  gfx->flush();
  frameNo++;
}

void setMode(int m, bool announce = true) {
  (void)announce;
  uint8_t old = mode;
  mode = ((m % M_COUNT) + M_COUNT) % M_COUNT;
  if (mode != M_CHARGE && mode != M_TORCH && !idleEyesOn) prefs.putUChar("mode", mode);
  if (old == M_TORCH && mode != M_TORCH && !sleeping) analogWrite(LCD_BL, brightness);
  if (mode == M_TORCH && old != M_TORCH) { analogWrite(LCD_BL, 255); chromeUntil = millis() + 2500; }
  if (mode == M_EYES && old != M_EYES) { chromeUntil = millis() + 1500; tiltBaseX = tiltX; tiltBaseY = tiltY; nextIdleExpr = millis() + 4000; exprShown = 255; }
  if (mode == M_PHOTO) chromeUntil = millis() + 1500;
  if (mode == M_SING) singRestart();
  if (mode == M_TEXT) typeStart = millis();
  glitchFrames = 3;
}

// A frame grows out of the tapped block until it fills the screen (or shrinks back into it).
void zoomAnim(int ti, bool opening) {
  if (!FB || !prevFb || sleeping || ti < 0) return;
  memcpy(prevFb, FB, FB_BYTES);
  const int steps = 6;
  for (int s = 1; s <= steps; s++) {
    float t = (float)s / steps;
    t = 1.0f - (1.0f - t) * (1.0f - t);
    if (!opening) t = 1.0f - t;
    int x = TILE_X[ti] - (int)(TILE_X[ti] * t), y = TILE_Y[ti] - (int)(TILE_Y[ti] * t);
    int w = TILE_W[ti] + (int)((SCR_W - TILE_W[ti]) * t), h = TILE_H[ti] + (int)((SCR_H - TILE_H[ti]) * t);
    memcpy(FB, prevFb, FB_BYTES);
    gfx->fillRect(x, y, w, h, COL_BLACK);
    gfx->drawRect(x, y, w, h, ACC);
    gfx->drawRect(x + 1, y + 1, w - 2, h - 2, ACC);
    gfx->flush();
  }
}

void openModule(int m) {
  if (mode == M_DECK) { sfx(1); zoomAnim(tileOfMode(m), true); }
  setMode(m);
  lastFrame = 0;
}

void closeModule() {
  if (mode == M_DECK) return;
  if (mode == M_CHARGE) { setMode(chargeReturn == M_CHARGE ? M_DECK : chargeReturn); lastFrame = 0; return; }
  int ti = tileOfMode(mode);
  sfx(1);
  setMode(M_DECK);
  updateAccent();
  drawScene();
  zoomAnim(ti, false);
  glitchFrames = 1;
  lastFrame = 0;
}

// The idle eyes (an option): when the sleep timer runs out, the eyes take over and doze off first.
void idleEyesEnd() {
  if (!idleEyesOn) return;
  idleEyesOn = false;
  exprAuto = true;
  setMode(idleReturn);
  if (!sleeping) analogWrite(LCD_BL, mode == M_TORCH ? 255 : brightness);
  lastFrame = 0;
}

void sendStatus(const char *extra);
// ───────────── Status notifications ─────────────
void notifyText(const char *s) {
  if (!statusChar || !bleConnected) return;
  statusChar->setValue((const uint8_t *)s, strlen(s));
  statusChar->notify();
}

void sendStatus(const char *extra = nullptr) {
  char buf[300];
  unsigned long used = fsOK ? (unsigned long)FFat.usedBytes() : 0;
  unsigned long total = fsOK ? (unsigned long)FFat.totalBytes() : 0;
  snprintf(buf, sizeof(buf), "b=%d;v=%.2f;c=%d;m=%d;fw=%s;fs=%lu,%lu;lk=%d,%d;imu=%d;toy=%d;th=%d;st=%lu;eye=%d;jb=%d;q=%d%s%s",
           batPct, batVolts, charging ? 1 : 0, mode, FW_VERSION, used, total,
           bgStyle, faceStyle, imuOK ? 1 : 0, toyKind, theme, (unsigned long)stepsToday,
           exprAuto ? 255 : exprSet, jbPlaying ? jbSong : -1, jbQLen,
           extra ? ";" : "", extra ? extra : "");
  notifyText(buf);
}

// ───────────── Transfers ─────────────
void xferCleanup() {
  if (xferFile) xferFile.close();
  if (xferKind == 2 && fsOK) FFat.remove("/c/tmp.part");
  if (xferKind == 4 && fsOK) FFat.remove("/s/tmp.part");
  xferActive = false;
  xferBufLen = 0;
}

void xferFlush() {
  if ((xferKind == 2 || xferKind == 4) && xferFile && xferBufLen) { xferFile.write(xferBuf, xferBufLen); xferBufLen = 0; }
}

// decodes the album-cover JPEG straight into its own full-screen buffer
int jpegToArt(JPEGDRAW *p) {
  if (p->x < 0 || p->x >= SCR_W) return 1;
  int w = min((int)p->iWidth, SCR_W - (int)p->x);
  for (int row = 0; row < p->iHeight; row++) {
    int y = p->y + row;
    if (y < 0 || y >= SCR_H) continue;
    memcpy(artBuf + y * SCR_W + p->x, p->pPixels + row * p->iWidth, w * 2);
  }
  return 1;
}

static uint32_t rdU32(const uint8_t *p) { return p[0] | (p[1] << 8) | (p[2] << 16) | ((uint32_t)p[3] << 24); }

void xferBegin(const uint8_t *p, uint16_t len) {
  if (xferActive) xferCleanup();
  if (len < 5) { sendStatus("xfer=err;why=bad"); return; }
  xferKind = p[0];
  xferSize = rdU32(p + 1);
  xferId = len >= 9 ? rdU32(p + 5) : 0;
  xferGot = xferAcked = 0;
  xferBufLen = 0;
  bool ok = false;
  const char *why = "bad";
  if (xferKind == 0)      { ok = photoBuf && xferSize == FB_BYTES; if (ok) photoLoaded = false; }
  else if (xferKind == 3) { ok = artBuf && artJpg && xferSize > 100 && xferSize <= ART_JPG_MAX; }
  else if (xferKind == 5) { ok = xferBuf && xferSize >= 9 && xferSize <= 2048; }      // a sing-along show
  else if (xferKind == 4) {                        // a song: written to /s/<slot>.sng
    int slot = -1;
    for (int i = 0; i < MY_SONGS; i++) if (!mySongHas[i]) { slot = i; break; }
    if (!fsOK) why = "nofs";
    else if (slot < 0) why = "full";
    else if (xferSize <= sizeof(SongHdr) || xferSize > sizeof(SongHdr) + MY_SONG_MAX * 2) why = "bad";
    else { xferId = slot; FFat.remove("/s/tmp.part"); xferFile = FFat.open("/s/tmp.part", "w"); ok = (bool)xferFile && xferBuf; if (!ok) why = "open"; }
  }
  if (!ok) { char b[32]; snprintf(b, sizeof(b), "xfer=err;why=%s", why); sendStatus(b); return; }
  xferActive = true;
  xferAbort = false;
}

void xferData(const uint8_t *p, uint16_t len) {
  if (!xferActive) return;
  uint32_t take = min<uint32_t>(len, xferSize - xferGot);
  if (xferKind == 0)      memcpy((uint8_t *)photoBuf + xferGot, p, take);
  else if (xferKind == 3) memcpy(artJpg + xferGot, p, take);
  else if (xferKind == 5) memcpy(xferBuf + xferGot, p, take);
  else if (xferKind == 4) { memcpy(xferBuf + xferBufLen, p, take); xferBufLen += take; if (xferBufLen > XBUF_SZ - 520) xferFlush(); }
  else {
    uint32_t off = 0;
    while (off < take) {
      uint32_t n = min<uint32_t>(take - off, XBUF_SZ - xferBufLen);
      memcpy(xferBuf + xferBufLen, p + off, n);
      xferBufLen += n; off += n;
      if (xferBufLen == XBUF_SZ) xferFlush();
    }
  }
  xferGot += take;
}

void xferEnd() {
  if (!xferActive || xferGot != xferSize) { xferCleanup(); sendStatus("xfer=err;why=short"); return; }
  if (xferKind == 0) {
    photoLoaded = true;
    if (fsOK) { File f = FFat.open("/photo.bin", "w"); if (f) { f.write((uint8_t *)photoBuf, FB_BYTES); f.close(); } }
    xferActive = false;
    setMode(M_PHOTO, false);
    klog("fs: photo.bin %luk", (unsigned long)(xferSize / 1024));
  } else if (xferKind == 3) {
    xferActive = false;
    bool ok = false;
    if (jpeg.openRAM(artJpg, xferSize, jpegToArt)) {
      jpeg.setPixelType(RGB565_LITTLE_ENDIAN);
      ok = jpeg.decode(0, 0, 0);
      jpeg.close();
    }
    artLoaded = ok;
    if (!ok) { sendStatus("xfer=err;why=format"); return; }
  } else if (xferKind == 5) {
    xferActive = false;
    if (!showParse(xferBuf, xferSize)) { sendStatus("xfer=err;why=format"); return; }
    showLoaded = true;
    if (fsOK) { File f = FFat.open("/show.bin", "w"); if (f) { f.write(xferBuf, xferSize); f.close(); } }
    setMode(M_SING, false);
    singRestart();
    toast("new show", 1200);
    klog("fs: show.bin, %lu bytes", (unsigned long)xferSize);
  } else if (xferKind == 4) {
    xferFlush();
    xferFile.close();
    File f = FFat.open("/s/tmp.part", "r");
    SongHdr h;
    bool ok = f && f.read((uint8_t *)&h, sizeof(h)) == sizeof(h) && memcmp(h.magic, "LSNG", 4) == 0 && h.n > 0 && h.n <= MY_SONG_MAX && f.size() >= sizeof(h) + h.n * 2;
    if (f) f.close();
    if (!ok) { xferCleanup(); sendStatus("xfer=err;why=format"); return; }
    FFat.remove(mySongPath(xferId));
    FFat.rename("/s/tmp.part", mySongPath(xferId));
    xferActive = false;
    scanMySongs();
    jbCat = MY_CAT; jbSelId = 100 + xferId;
    toast("song added", 1200);
    klog("fs: song %d saved", 100 + (int)xferId);
  }
  char b[32]; snprintf(b, sizeof(b), "ack=%lu", (unsigned long)xferGot);
  notifyText(b);
  sendStatus("xfer=ok");
}

// ───────────── Command handling ─────────────
void handlePacket(const uint8_t *d, uint16_t n) {
  if (n == 0) return;
  // background traffic (now-playing updates, album art, time sync) must not keep the screen awake
  bool quiet = d[0] == CMD_XFER_DATA || d[0] == CMD_NOWPLAYING || d[0] == CMD_PING || d[0] == CMD_TIME ||
               (d[0] == CMD_XFER_BEGIN && n >= 2 && d[1] == 3) || (d[0] == CMD_XFER_END && xferKind == 3);
  if (!quiet) touchActivity();
  else if (d[0] == CMD_XFER_DATA && xferKind != 3) lastInteraction = millis();
  const uint8_t *p = d + 1; uint16_t len = n - 1;
  switch (d[0]) {
    case CMD_MODE: if (len >= 1) setMode(p[0]); break;

    case CMD_TEXT:
      if (len >= 5) {
        textStyle = p[0] % TEXT_STYLES;
        textFg = (p[1] << 8) | p[2];
        textBg = (p[3] << 8) | p[4];
        textMsg = String((const char *)(p + 5), len - 5);
        layoutText();
        prefs.putString("text", textMsg); prefs.putUChar("tstyle", textStyle);
        prefs.putUShort("tfg", textFg);   prefs.putUShort("tbg", textBg);
        setMode(M_TEXT, false);
        klog("rx: motd, %u bytes", (unsigned)textMsg.length());
      }
      break;

    case CMD_TIME:
      if (len >= 6) {
        time_t e = rdU32(p);
        tzMin = (int16_t)(p[4] | (p[5] << 8));
        setSystemTime(e);
        rtcWriteUTC(e);
        prefs.putShort("tz", tzMin);
        klog("rtc: synced, utc%+d:%02d", tzMin / 60, abs(tzMin) % 60);
      }
      break;

    case CMD_NOWPLAYING:
      if (len >= 12) {
        npColor = c565(p[0], p[1], p[2]);
        npPlaying = p[3];
        npPosMs = rdU32(p + 4);
        npDurMs = rdU32(p + 8);
        npStamp = millis();
        String s((const char *)(p + 12), len - 12);
        int sep = s.indexOf('\x1F');
        String newTitle = sep >= 0 ? s.substring(0, sep) : s;
        if (newTitle != npTitle) { artLoaded = false; npTitleX = 0; }
        npTitle = newTitle;
        npArtist = sep >= 0 ? s.substring(sep + 1) : "";
      }
      break;

    case CMD_XFER_BEGIN: xferBegin(p, len); break;
    case CMD_XFER_DATA:  xferData(p, len);  break;
    case CMD_XFER_END:   xferEnd();         break;

    case CMD_BRIGHTNESS:
      if (len >= 1) { setBacklight(p[0]); prefs.putUChar("bright", brightness); }
      break;

    case CMD_PET:
      if (len >= 4) {
        petSpecies = p[0] % 3;
        petColor = c565(p[1], p[2], p[3]);
        if (len > 4) petName = String((const char *)(p + 4), len - 4);
        prefs.putUChar("petsp", petSpecies); prefs.putUShort("petcol", petColor);
        prefs.putString("petname", petName);
        setMode(M_PET, false);
      }
      break;

    case CMD_PET_FEED:
      petMood = min(100, petMood + 25);
      petHeartsUntil = millis() + 2500;
      prefs.putInt("petmood", petMood);
      setMode(M_PET, false);
      break;

    case CMD_CARD:
      if (len >= 3) {
        cardAccent = c565(p[0], p[1], p[2]);
        String s((const char *)(p + 3), len - 3);
        int sep = s.indexOf('\x1F');
        cardName = sep >= 0 ? s.substring(0, sep) : s;
        cardSub  = sep >= 0 ? s.substring(sep + 1) : "";
        prefs.putString("cname", cardName); prefs.putString("csub", cardSub);
        prefs.putUShort("cacc", cardAccent);
        setMode(M_CARD, false);
      }
      break;

    case CMD_SETTINGS:
      if (len >= 3) {
        sleepSec = p[0] | (p[1] << 8);
        swapSwipe = p[2];
        prefs.putUShort("sleep", sleepSec); prefs.putBool("swap", swapSwipe);
        if (len >= 4) { soundsOn = p[3] & 1; shakeWake = p[3] & 2; hourChime = p[3] & 4; fxOn = p[3] & 8; eyesIdle = p[3] & 16; prefs.putUChar("flags", p[3] & 63); }
        if (len >= 5) { tiltBits = p[4] & 7; prefs.putUChar("tilt", tiltBits); }
      }
      break;

    case CMD_LOOK:
      if (len >= 2) {
        bgStyle = p[0] % BG_COUNT;
        faceStyle = p[1] % FACE_COUNT;
        prefs.putUChar("bg", bgStyle); prefs.putUChar("face", faceStyle);
        if (len >= 3) { theme = p[2] % THEME_COUNT; prefs.putUChar("theme", theme); }
        if (mode == M_DECK) glitchFrames = 2; else setMode(M_CLOCK, false);     // the deck shows the background too
      }
      break;

    case CMD_THEME:
      if (len >= 1) {
        theme = p[0] % THEME_COUNT;
        prefs.putUChar("theme", theme);
        themePreviewUntil = millis() + 2500;
        glitchFrames = 2;
        toast(THEME_NAMES[theme], 900);
        klog("tty: theme %s", THEME_NAMES[theme]);
      }
      break;

    case CMD_TIMER:
      if (len >= 2) {
        uint32_t sec = p[0] | (p[1] << 8);
        alarmUntil = 0;
        timerEndAt = sec ? (millis() + sec * 1000UL) : 0;
        if (timerEndAt == 0 && sec) timerEndAt = 1;
        toast(sec ? "timer set" : "timer off", 900);
      }
      break;

    case CMD_TOY:
      if (len >= 1) {
        if (p[0] % 3 != toyKind) { toyKind = p[0] % 3; toyHasResult = false; toyRollAt = 0; prefs.putUChar("toy", toyKind); }
        setMode(M_TOY, false);
        if (len >= 2 && p[1]) toyRoll();
      }
      break;

    case CMD_EYES:
      if (len >= 1) {
        if (p[0] >= EXPR_COUNT) exprAuto = true; else setExpr(p[0], 10000);
        if (mode != M_EYES) openModule(M_EYES);
      }
      break;

    case CMD_TUNE:
      if (len >= 1) {
        if (p[0] == 0) jbStop();
        else if (p[0] == 3) jbSkip();
        else {
          if (p[0] == 1) jbStop();
          for (int i = 1; i < len; i++) jbEnqueue(p[i]);
          if (p[0] == 1 && mode != M_JUKE) openModule(M_JUKE);
        }
        sendStatus();
      }
      break;

    case CMD_TORCH:
      if (len >= 1) {
        if (len >= 2) torchCol = p[1] & 3;
        if (p[0] && mode != M_TORCH) openModule(M_TORCH);
        else if (!p[0] && mode == M_TORCH) closeModule();
      }
      break;

    case CMD_SONG_LIST:
      for (int i = 0; i < MY_SONGS; i++) if (mySongHas[i]) {
        char b[64]; snprintf(b, sizeof(b), "song=%d,%u,%s", 100 + i, mySongN[i], mySongName[i]); notifyText(b); delay(20);
      }
      sendStatus("songs=end");
      break;

    case CMD_SONG_DELETE:
      if (len >= 1 && p[0] >= 100 && p[0] < 100 + MY_SONGS && fsOK) {
        if (jbSong == p[0]) jbStop();
        FFat.remove(mySongPath(p[0] - 100));
        scanMySongs();
        if (jbCat >= catCount()) jbCat = 0;
        if (!songExists(jbSelId)) jbSelId = 0;
      }
      sendStatus("songs=changed");
      break;

    case CMD_PING:      sendStatus(); break;
    case CMD_BUZZ:      beep(len >= 1 ? constrain((int)p[0], 1, 10) : 3); break;
  }
}

// ───────────── BLE ─────────────
class ServerCB : public NimBLEServerCallbacks {
  void onConnect(NimBLEServer *s, NimBLEConnInfo &info) override {
    bleConnected = true;
    toast("link up", 1000);
  }
  void onDisconnect(NimBLEServer *s, NimBLEConnInfo &info, int reason) override {
    bleConnected = false;
    xferAbort = true;
    NimBLEDevice::startAdvertising();
  }
};

class RxCB : public NimBLECharacteristicCallbacks {
  void onWrite(NimBLECharacteristic *c, NimBLEConnInfo &info) override {
    static Packet pkt;
    NimBLEAttValue v = c->getValue();
    pkt.len = min<size_t>(v.length(), sizeof(pkt.data));
    memcpy(pkt.data, v.data(), pkt.len);
    xQueueSend(rxQueue, &pkt, pdMS_TO_TICKS(3000));
  }
};

void bleInit() {
  NimBLEDevice::init(DEVICE_NAME);
  NimBLEDevice::setMTU(517);
  NimBLEServer *server = NimBLEDevice::createServer();
  server->setCallbacks(new ServerCB());
  NimBLEService *svc = server->createService(SVC_UUID);
  NimBLECharacteristic *rx = svc->createCharacteristic(RX_UUID, NIMBLE_PROPERTY::WRITE | NIMBLE_PROPERTY::WRITE_NR);
  rx->setCallbacks(new RxCB());
  statusChar = svc->createCharacteristic(STATUS_UUID, NIMBLE_PROPERTY::READ | NIMBLE_PROPERTY::NOTIFY);
  statusChar->setValue((const uint8_t *)"hello", 5);
  NimBLEAdvertising *adv = NimBLEDevice::getAdvertising();
  adv->addServiceUUID(SVC_UUID);
  NimBLEAdvertisementData scan;
  scan.setName(DEVICE_NAME);
  adv->setScanResponseData(scan);
  adv->enableScanResponse(true);
  adv->start();
}

// ───────────── Touch: coordinate-based gestures ─────────────
void IRAM_ATTR onTouchInt() { touchFlag = true; }

void touchWrite(uint8_t reg, uint8_t val) {
  Wire.beginTransmission(CST816_ADDR); Wire.write(reg); Wire.write(val); Wire.endTransmission();
}

void touchInit() {
  pinMode(TP_RST, OUTPUT);
  digitalWrite(TP_RST, LOW);  delay(10);
  digitalWrite(TP_RST, HIGH); delay(60);
  touchWrite(0xFE, 0x01);   // DisAutoSleep: stay awake so every touch registers
  touchWrite(0xFA, 0x70);   // IrqCtl: interrupt on touch, change and motion
  pinMode(TP_INT, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(TP_INT), onTouchInt, FALLING);
}

bool readTouch(int16_t &x, int16_t &y, uint8_t &fingers) {
  Wire.beginTransmission(CST816_ADDR);
  Wire.write(0x02);
  if (Wire.endTransmission(false) != 0) return false;
  if (Wire.requestFrom((uint8_t)CST816_ADDR, (uint8_t)5) != 5) return false;
  fingers = Wire.read() & 0x0F;
  uint8_t xh = Wire.read(), xl = Wire.read(), yh = Wire.read(), yl = Wire.read();
  x = ((xh & 0x0F) << 8) | xl;
  y = ((yh & 0x0F) << 8) | yl;
  return true;
}

struct { bool down = false; bool consumed = false; int16_t x0 = 0, y0 = 0, x = 0, y = 0; uint32_t t0 = 0; } tch;
uint32_t lastTouchPoll = 0, lastTapAt = 0;

#define SWIPE_PX      40   // distance that commits a swipe while the finger is still down
#define FLICK_PX      22   // shorter distance accepted on release if it was quick
#define TAP_PX        16
#define LONGPRESS_MS 650

void cycleBg(int dir) {
  bgStyle = (bgStyle + BG_COUNT + dir) % BG_COUNT;
  if (bgStyle == 8 && !photoLoaded) bgStyle = (bgStyle + BG_COUNT + dir) % BG_COUNT;
  prefs.putUChar("bg", bgStyle);
  toast(BG_NAMES[bgStyle], 800);
  glitchFrames = 2;
  sfx(1);
}

// Sideways swipes act on whatever is open. dir +1 = finger moved left.
void onSwipe(int dir) {
  if (swapSwipe) dir = -dir;
  switch (mode) {
    case M_DECK:
      theme = (theme + THEME_COUNT + dir) % THEME_COUNT;
      prefs.putUChar("theme", theme);
      themePreviewUntil = millis() + 2500;
      toast(THEME_NAMES[theme], 900);
      glitchFrames = 2;
      sfx(1);
      break;
    case M_CLOCK: cycleBg(dir); break;
    case M_TEXT:
      textStyle = (textStyle + TEXT_STYLES + dir) % TEXT_STYLES;
      prefs.putUChar("tstyle", textStyle);
      marqueeX = SCR_W; typeStart = millis();
      sfx(1);
      break;
    case M_MUSIC: mediaCmd(dir > 0 ? 1 : 2); break;
    case M_TOY:
      toyKind = (toyKind + 3 + dir) % 3; toyHasResult = false; toyRollAt = 0;
      prefs.putUChar("toy", toyKind);
      sfx(1);
      break;
    case M_PET:
      petMood = min(100, petMood + 3);
      petHeartsUntil = millis() + 1500;
      break;
    case M_EYES: {
      uint8_t e = (exprShown + EXPR_COUNT + dir) % EXPR_COUNT;
      setExpr(e, 8000);
      toast(EXPR_NAMES[e], 800);
      sfx(4);
      break;
    }
    case M_JUKE:
      jbCat = (jbCat + catCount() + dir) % catCount(); sfx(1);
      break;
    case M_TORCH: torchCol = (torchCol + 4 + dir) % 4; break;
    case M_SING:  singSkip(dir); break;
    default: break;
  }
}

// Swipe down closes whatever is open. On the home screen, up and down change brightness.
void onVSwipe(int up) {
  if (up < 0 && mode != M_DECK) { closeModule(); return; }
  if (mode == M_TORCH) return;
  setBacklight(brightness + (up > 0 ? 40 : -40));
  prefs.putUChar("bright", brightness);
  toast(up > 0 ? "bright +" : "bright -", 500);
}

void onTap(bool dbl) {
  sfx(0);
  switch (mode) {
    case M_DECK:
      deckRun(tileAt(tch.x0, tch.y0));
      break;
    case M_CLOCK:
      if (dbl) {              // second tap of a double tap: undo the style change, flip 12/24 h
        faceStyle = (faceStyle + FACE_COUNT - 1) % FACE_COUNT;
        use24h = !use24h; prefs.putBool("h24", use24h);
        toast(use24h ? "24h" : "12h", 700);
      } else faceStyle = (faceStyle + 1) % FACE_COUNT;
      prefs.putUChar("face", faceStyle);
      break;
    case M_TEXT:
      textStyle = (textStyle + 1) % TEXT_STYLES;
      prefs.putUChar("tstyle", textStyle);
      marqueeX = SCR_W; typeStart = millis();
      break;
    case M_PHOTO: chromeUntil = millis() + 1500; break;
    case M_MUSIC: mediaCmd(tch.x0 < 80 ? 2 : tch.x0 > 160 ? 1 : 0); break;
    case M_PET:
      petMood = min(100, petMood + (dbl ? 25 : 3));
      petHeartsUntil = millis() + (dbl ? 2500 : 1500);
      if (dbl) { prefs.putInt("petmood", petMood); toast("yum!", 700); }
      break;
    case M_TOY:
      if (tch.y0 < 70) { toyKind = (toyKind + 1) % 3; toyHasResult = false; toyRollAt = 0; prefs.putUChar("toy", toyKind); }
      else toyRoll();
      break;
    case M_EYES:
      if (dbl) setExpr(E_LOVE, 3500);
      else {
        static const uint8_t R[5] = {E_HAPPY, E_LAUGH, E_SURPRISED, E_HAPPY, E_WINK};
        setExpr(R[random(0, 5)], 2500);
        blinkAt = millis();
      }
      sfx(4);
      break;
    case M_JUKE:
      {
        int16_t ids[JB_ROWS];
        int n = songsInCat(jbCat, ids, JB_ROWS), row = (tch.y0 - JB_ROW_Y) / JB_ROW_H;
        if (tch.y0 < JB_ROW_Y - 2) { jbCat = (jbCat + catCount() + (tch.x0 < 120 ? -1 : 1)) % catCount(); }
        else if (tch.y0 < 190 && row >= 0 && row < n) { bool was = jbPlaying; jbSelId = ids[row]; jbEnqueue(ids[row]); toast(was ? "queued" : "playing", 700); }
        else if (tch.y0 >= 190 && jbPlaying) { if (tch.x0 > 170) jbSkip(); else jbStop(); }
        else if (tch.y0 >= 190) jbStartSong(jbSelId);
      }
      break;
    case M_TORCH: torchCol = (torchCol + 1) % 4; chromeUntil = 0; break;
    case M_SING:  singTap(); break;
    case M_CHARGE: closeModule(); break;
    default: break;
  }
}

void onShake() {
  if (sleeping) {
    if (shakeWake) { touchActivity(); sfx(0); klog("imu: shake, waking up"); }
    return;
  }
  touchActivity();
  klog("imu: shake, |a|=%.1fg", sqrtf(accX * accX + accY * accY + accZ * accZ));
  switch (mode) {
    case M_DECK:
      // fall through
    case M_CLOCK: cycleBg(1); break;
    case M_PET:
      petDizzyUntil = millis() + 3000;
      toast("wheee!", 900);
      sfx(3);
      break;
    case M_TOY: toyRoll(); break;
    case M_TEXT:
      textStyle = (textStyle + 1) % TEXT_STYLES;
      prefs.putUChar("tstyle", textStyle);
      marqueeX = SCR_W; typeStart = millis();
      break;
    case M_EYES: setExpr(E_DIZZY, 3000); sfx(3); break;
    case M_SING: singJumpAt = millis(); sfx(3); break;
    case M_JUKE: { int16_t all[48]; int n = allSongs(all, 48); jbSelId = all[random(0, n)]; jbStop(); jbStartSong(jbSelId); toast("shuffle", 800); break; }
    default: break;
  }
}

void handleTouch() {
  uint32_t now = millis();
  if (!touchFlag && now - lastTouchPoll < 12) return;
  if (sleeping && !touchFlag && now - lastTouchPoll < 60) return;
  lastTouchPoll = now;
  touchFlag = false;
  int16_t x, y; uint8_t fingers;
  if (!readTouch(x, y, fingers)) return;

  if (fingers > 0) {
    if (!tch.down) {
      tch.down = true; tch.consumed = false;
      tch.x0 = tch.x = x; tch.y0 = tch.y = y; tch.t0 = now;
      if (alarmUntil) { alarmUntil = 0; noTone(BUZZER); touchActivity(); tch.consumed = true; return; }
      if (sleeping) { touchActivity(); tch.consumed = true; return; }   // first touch only wakes
      if (idleEyesOn) { touchActivity(); tch.consumed = true; return; } // and wakes you out of the idle eyes
      touchActivity();
    }
    tch.x = x; tch.y = y;
    lastInteraction = now;
    int dx = x - tch.x0, dy = y - tch.y0;
    if (tch.consumed) return;
    if (abs(dx) >= SWIPE_PX && abs(dx) > abs(dy)) { tch.consumed = true; onSwipe(dx < 0 ? 1 : -1); return; }
    if (abs(dy) >= SWIPE_PX && abs(dy) > abs(dx)) { tch.consumed = true; onVSwipe(dy < 0 ? 1 : -1); return; }
    if (now - tch.t0 > LONGPRESS_MS && abs(dx) < TAP_PX && abs(dy) < TAP_PX) {
      tch.consumed = true;
      if (mode == M_CARD) closeModule();
      else openModule(M_CARD);                                    // anywhere else: the ID card
    }
  } else if (tch.down) {
    tch.down = false;
    if (tch.consumed) return;
    int dx = tch.x - tch.x0, dy = tch.y - tch.y0;
    uint32_t dt = now - tch.t0;
    if (abs(dx) < TAP_PX && abs(dy) < TAP_PX) {
      bool dbl = (now - lastTapAt) < 350;
      lastTapAt = dbl ? 0 : now;
      onTap(dbl);
    } else if (dt < 400 && abs(dx) >= FLICK_PX && abs(dx) > abs(dy)) {
      onSwipe(dx < 0 ? 1 : -1);
    } else if (dt < 400 && abs(dy) >= FLICK_PX && abs(dy) > abs(dx)) {
      onVSwipe(dy < 0 ? 1 : -1);
    }
  }
}

// ───────────── Power & battery ─────────────
void handleButton() {
  static bool armed = false;
  static uint32_t downAt = 0;
  static bool wasDown = false;
  bool down = digitalRead(SYS_OUT) == LOW;
  if (!armed) { if (!down) armed = true; return; }

  if (down && !wasDown) downAt = millis();
  if (down && millis() - downAt > 2000) {
    gfx->fillScreen(COL_BLACK);
    textCentered("SHUTDOWN", 124, 3, ACC);
    gfx->flush();
    tone(BUZZER, 1800, 120); delay(200); noTone(BUZZER);
    savePrefs();
    digitalWrite(SYS_EN, LOW);
    delay(1500);
    toast("on USB power", 1500);
    armed = false;
    wasDown = true;
    return;
  }
  if (!down && wasDown && millis() - downAt < 600) {
    if (alarmUntil) { alarmUntil = 0; noTone(BUZZER); touchActivity(); }
    else if (sleeping) touchActivity();
    else if (mode != M_DECK) { touchActivity(); closeModule(); }
    else { sleeping = true; analogWrite(LCD_BL, 0); }             // on the deck: screen off
  }
  wasDown = down;
}

int voltsToPct(float v) {
  const float V[] = {3.30, 3.60, 3.70, 3.75, 3.80, 3.90, 4.00, 4.10, 4.20};
  const int   P[] = {0,    8,    20,   35,   48,   65,   80,   92,   100};
  if (v >= V[8]) return 100;
  if (v <= V[0]) return 0;
  for (int i = 0; i < 8; i++)
    if (v < V[i + 1]) return P[i] + (int)((v - V[i]) / (V[i + 1] - V[i]) * (P[i + 1] - P[i]));
  return 100;
}

void updateBattery() {
  uint32_t now = millis();
  if (lastBatRead && now - lastBatRead < 1000) return;
  lastBatRead = now;
  uint32_t mv = 0;
  for (int i = 0; i < 16; i++) mv += analogReadMilliVolts(BAT_ADC);
  float v = (mv / 16) * 3.0f / 1000.0f;
  vFast = (vHistN == 0) ? v : vFast * 0.5f + v * 0.5f;
  batVolts = (vHistN == 0) ? v : batVolts * 0.85f + v * 0.15f;

  // The board has no "charger connected" pin. USB power shows up two ways:
  //  - a computer: the USB port reports a host straight away
  //  - a plain charger: the battery voltage jumps up ~0.1 V within a few seconds of plugging in, and drops the same way when unplugged
  // Anything else is just the battery, so nothing slow or guessed counts as charging any more.
  float lo = vFast, hi = vFast;
  for (int i = 0; i < min(vHistN, 6); i++) { lo = min(lo, vHist[i]); hi = max(hi, vHist[i]); }
  if (vHistN >= 3 && !wallPower && vFast - lo > 0.07f) { wallPower = true; batVolts = vFast; }
  else if (wallPower && hi - vFast > 0.07f) { wallPower = false; batVolts = vFast; }
  vHist[vHistN % 6] = vFast;
  vHistN++;
  if (now - lastSlowAt >= 10000) {                 // a charger never lets the voltage sag for a whole minute
    lastSlowAt = now;
    vSlow[vSlowN % 6] = vFast; vSlowN++;
    if (wallPower && vSlowN >= 6 && vSlow[(vSlowN - 6) % 6] - vFast > 0.03f) wallPower = false;
  }

  bool usb = Serial.isPlugged();
  bool wasCharging = charging;
  charging = usb || wallPower;

  // the charger lifts the voltage, so read a little lower while charging
  int pct = voltsToPct(charging ? batVolts - 0.10f : batVolts);
  batPct = constrain(pct, 0, 100);

  // plugged in: show the charging screen. Unplugged: go back to what was open.
  if (charging && !wasCharging) {
    touchActivity();
    if (mode != M_CHARGE && !xferActive) { chargeReturn = mode == M_TORCH ? M_DECK : mode; setMode(M_CHARGE); }
  }
  if (!charging && wasCharging) {
    if (mode == M_CHARGE) setMode(chargeReturn);
    toast("unplugged", 1200);
  }
  static bool lowWarned = false, fullWarned = false;
  if (!charging && batPct <= 15 && !lowWarned && vHistN > 3) { lowWarned = true; toast("battery low", 2500); }
  if (batPct >= 20) lowWarned = false;
  if (charging && batPct >= 100 && !fullWarned) { fullWarned = true; toast("fully charged", 2500); }
  if (!charging) fullWarned = false;
}

void updatePet() {
  static uint32_t lastStepChk = 0;
  if (millis() - lastStepChk > 5000) { lastStepChk = millis(); stepDayCheck(); }
  if (millis() - petLastDecay > 10UL * 60 * 1000) {
    petLastDecay = millis();
    if (petMood > 0) { petMood--; prefs.putInt("petmood", petMood); }
  }
  if (moveTicks > 400) {              // carrying it around counts as a walk
    moveTicks = 0;
    if (petMood < 100) petMood++;
  }
}

void serviceTimers() {
  uint32_t now = millis();
  if (timerEndAt && (int32_t)(now - timerEndAt) >= 0) {
    timerEndAt = 0;
    alarmUntil = now + 20000;
    alarmNextBeep = 0;
    jbStop();
    touchActivity();
  }
  if (alarmUntil) {
    if (now > alarmUntil) alarmUntil = 0;
    else if (now >= alarmNextBeep) {
      alarmNextBeep = now + 900;
      tone(BUZZER, 2093, 110); tone(BUZZER, 2637, 110); tone(BUZZER, 3136, 160);
      lastInteraction = now;
    }
  }
  static uint32_t lastChk = 0;
  if (hourChime && !jbPlaying && now - lastChk > 1000) {
    lastChk = now;
    struct tm t;
    if (localNow(t) && t.tm_min == 0 && t.tm_hour != lastChimeHour) {
      lastChimeHour = t.tm_hour;
      tone(BUZZER, 2093, 90); tone(BUZZER, 2637, 140);
    }
  }
}

// ───────────── Setup / loop ─────────────
int bootY = 54;
void bootLine(const char *k, const char *v, bool ok) {
  textAt(String("> ") + k, 24, bootY, 1, ACC);
  textAt(v, 216 - (int)strlen(v) * 6, bootY, 1, ok ? COL_WHITE : COL_AMBER);
  bootY += 14;
  gfx->flush();
  delay(60);
}

void setup() {
  pinMode(SYS_EN, OUTPUT);
  digitalWrite(SYS_EN, HIGH);
  pinMode(SYS_OUT, INPUT);
  pinMode(BUZZER, OUTPUT);

  Serial.begin(115200);
  setCpuFrequencyMhz(240);

  Wire.begin(I2C_SDA, I2C_SCL, 400000);
  prefs.begin("charm", false);
  loadPrefs();

  if (!gfx->begin(80000000)) Serial.println("display init failed");
  gfx->fillScreen(COL_BLACK);
  gfx->flush();
  pinMode(LCD_BL, OUTPUT);
  analogWrite(LCD_BL, brightness);

  // boot log: each line is a real check
  FB = gfx->getFramebuffer();
  snapAccent();
  {
    textAt("LARP//OS", 24, 22, 2, ACC);
    textAt("v" FW_VERSION, 130, 29, 1, COL_WHITE);
    gfx->drawFastHLine(24, 42, 192, ACC_DIM);
  }
  bootLine("display", "ST7789 240x280", true);

  touchInit();
  bootLine("touch", "CST816", true);
  imuInit();
  bootLine("motion", imuOK ? "QMI8658" : "no reply", imuOK);
  initFx();

  photoBuf = (uint16_t *)ps_malloc(FB_BYTES);
  artBuf   = (uint16_t *)ps_malloc(FB_BYTES);
  artJpg   = (uint8_t *)ps_malloc(ART_JPG_MAX);
  prevFb   = (uint16_t *)ps_malloc(FB_BYTES);
  jbNotesBuf = (uint8_t *)ps_malloc(MY_SONG_MAX * 2);
  bootLine("memory", (photoBuf && artBuf && artJpg && prevFb) ? "PSRAM ok" : "low", photoBuf && artBuf && artJpg && prevFb);
  xferBuf  = (uint8_t *)malloc(XBUF_SZ);
  if (!xferBuf) xferBuf = (uint8_t *)ps_malloc(XBUF_SZ);

  fsOK = FFat.begin(true);
  if (!fsOK) Serial.println("FFat mount failed - check Partition Scheme (16M Flash 3MB APP/9.9MB FATFS)");
  if (fsOK) {
    if (!FFat.exists("/s")) FFat.mkdir("/s");
    FFat.remove("/s/tmp.part");
    File f = FFat.open("/photo.bin", "r");
    if (f && photoBuf && f.size() == FB_BYTES) { f.read((uint8_t *)photoBuf, FB_BYTES); photoLoaded = true; }
    if (f) f.close();
  }
  scanMySongs();
  bootLine("storage", fsOK ? "FFat ok" : "not mounted", fsOK);

  time_t e;
  if (rtcReadUTC(e)) setSystemTime(e);
  bootLine("clock", timeValid ? "RTC ok" : "needs sync", timeValid);

  layoutText();
  rxQueue = xQueueCreate(32, sizeof(Packet));
  bleInit();
  bootLine("uplink", "BLE ready", true);
  updateBattery();
  char pw[16];
  snprintf(pw, sizeof(pw), "%d%% %.2fV", batPct, batVolts);
  bootLine("power", pw, batPct > 15);

  textAt("JACKING IN", 24, bootY + 12, 2, COL_WHITE);
  gfx->flush();
  sfx(2);
  delay(450);
  lastInteraction = millis();
  if (charging) { chargeReturn = mode; setMode(M_CHARGE, false); }
  else setMode(mode, false);
  glitchFrames = 5;
  klog("kernel: larp-os " FW_VERSION " up");
  klog("imu: %s", imuOK ? "qmi8658 online" : "no reply");
  klog("fs: %s", fsOK ? "ffat mounted" : "not mounted");
  klog("rtc: %s", timeValid ? "clock ok" : "needs sync");
}

// Turns changes in the charm's state into log lines for the deck's dmesg pane.
void klogWatch() {
  static bool inited = false, ble = false, chg = false;
  static int batBand = -1, songWas = -1;
  static uint32_t stepsBand = 0, timerWas = 0, alarmWas = 0;
  static String trackWas;
  if (!inited) {
    inited = true; ble = bleConnected; chg = charging; batBand = batPct / 10; stepsBand = stepsToday / 500;
    songWas = jbPlaying ? jbSong : -1; trackWas = npTitle;
    return;
  }
  if (bleConnected != ble) { ble = bleConnected; klog(ble ? "ble: link up" : "ble: link down"); }
  if (charging != chg) { chg = charging; klog(chg ? "pwr: charging, %d%%" : "pwr: on battery, %d%%", batPct); }
  if (batPct / 10 != batBand) { if (!charging && batPct / 10 < batBand) klog("pwr: battery %d%%, %.2fv", batPct, batVolts); batBand = batPct / 10; }
  if (stepsToday / 500 != stepsBand) { stepsBand = stepsToday / 500; if (stepsBand) klog("ped: %lu steps today", (unsigned long)stepsToday); }
  if ((timerEndAt != 0) != (timerWas != 0)) { if (timerEndAt) klog("tmr: armed, %lum", (unsigned long)((timerEndAt - millis() + 59999) / 60000)); timerWas = timerEndAt; }
  if ((alarmUntil != 0) && !alarmWas) klog("tmr: time's up");
  alarmWas = alarmUntil;
  int song = jbPlaying ? jbSong : -1;
  if (song != songWas) { songWas = song; if (song >= 0) klog("snd: %s", songName(song)); }
  if (npTitle != trackWas) { trackWas = npTitle; if (npTitle.length()) klog("np: %s", asciiOnly(npTitle).c_str()); }
}

void loop() {
  static Packet pkt;
  bool gotData = false;
  int handled = 0;
  while (handled < 40 && xQueueReceive(rxQueue, &pkt, 0) == pdTRUE) {
    handlePacket(pkt.data, pkt.len);
    if (pkt.len && pkt.data[0] == CMD_XFER_DATA) gotData = true;
    handled++;
  }
  if (xferAbort) { xferAbort = false; if (xferActive) xferCleanup(); }
  if (gotData && xferActive && xferGot != xferAcked && uxQueueMessagesWaiting(rxQueue) == 0) {
    char b[24]; snprintf(b, sizeof(b), "ack=%lu", (unsigned long)xferGot);
    notifyText(b);
    xferAcked = xferGot;
  }

  handleTouch();
  handleButton();
  klogWatch();
  if (imuUpdate()) onShake();
  serviceTimers();
  updateBattery();
  updatePet();

  jbService();
  uint32_t idleLimit = mode == M_TORCH ? 300000UL : sleepSec * 1000UL;   // the torch stays on for 5 minutes
  if (!sleeping && sleepSec > 0 && !xferActive && !alarmUntil && millis() - lastInteraction > idleLimit) {
    if (eyesIdle && !idleEyesOn && mode != M_TORCH && mode != M_EYES && mode != M_CHARGE) {
      idleReturn = mode;
      setMode(M_EYES);
      idleEyesOn = true;
      setExpr(E_SLEEPY, 600000);
      chromeUntil = 0;
      analogWrite(LCD_BL, max(10, brightness / 3));
      lastInteraction = millis();
    } else {
      if (idleEyesOn) { idleEyesOn = false; exprAuto = true; setMode(idleReturn); }
      if (mode == M_TORCH) setMode(M_DECK);
      sleeping = true;
      analogWrite(LCD_BL, 0);
    }
  }

  if (bleConnected && (millis() - lastStatus > 15000 || jbDirty)) { lastStatus = millis(); jbDirty = false; sendStatus(); }

  if (sleeping) { delay(10); return; }

  uint32_t interval = (xferActive && xferKind != 3) ? 150 : 33;
  if (millis() - lastFrame >= interval) {
    lastFrame = millis();
    render();
  }
}
