    textAt(m, 120 - strlen(m) * 6, 199, 2, c565(12, 12, 14));
    textAt("sent to Claude Code", 63, 238, 1, CC_DIM);
    if (now - ccPermAnsweredAt > 1600) { ccPermOn = false; if (ccPermReturn != M_CLAUDE && mode == M_CLAUDE) setMode(ccPermReturn); }
  }
}

