    textAt("allow", 174 - 30, 199, 2, CC_GREEN);
    char b[40]; snprintf(b, sizeof(b), "or answer on your laptop  %lus", (unsigned long)left);
    textAt(b, 120 - strlen(b) * 3, 238, 1, CC_DIM);
  } else {
    const char *m = ccPermAnswer ? "allowed" : "denied";
