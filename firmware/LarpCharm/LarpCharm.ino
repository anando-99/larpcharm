           batPct, batVolts, charging ? 1 : 0, mode, FW_VERSION, used, total,
           bgStyle, faceStyle, imuOK ? 1 : 0, toyKind, theme, (unsigned long)stepsToday,
           exprAuto ? 255 : exprSet, jbPlaying ? jbSong : -1, jbQLen,
           extra ? ";" : "", extra ? extra : "");
