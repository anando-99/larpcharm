  CMD_THEME       = 0x15, // [theme 0..5]
  // 0x16 was the look switch (removed in 8.0: the deck is the only look)
  CMD_EYES        = 0x17, // [expression 0..11, 255 = automatic]
  CMD_TUNE        = 0x18, // [op 0=stop 1=play now 2=add to queue 3=skip][song ids...]
  CMD_TORCH       = 0x19, // [on 0/1][colour 0..3]
  CMD_SONG_LIST   = 0x1A, // -> "song=id,notes,name" ... "songs=end"
  CMD_SONG_DELETE = 0x1B, // [song id 100..107]
  // 0x1C, 0x1D were the Cotton profile and mood (removed in 8.0)
  CMD_AUTH        = 0x22, // [op] 0 ask to pair (the charm shows a code) · 1 answer the challenge [HMAC-SHA256, 32] · 2 the code [6 digits] · 3 forget other browsers
  CMD_SPELL       = 0x21, // [op] 0 action: [spell 0..3 or 10+slot][action] · 1 teach: [slot][action] name · 2 stop teaching · 3 forget [slot] · 4 list · 5 open · 6 wipe the sketch · 7 view [0 cast 1 knob 2 draw 3 map]
