  gfx->drawFastHLine(x, y + h - 1, k, c);         gfx->drawFastVLine(x, y + h - k, k, c);
  gfx->drawFastHLine(x + w - k, y + h - 1, k, c); gfx->drawFastVLine(x + w - 1, y + h - k, k, c);
